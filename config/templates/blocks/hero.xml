<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template">

    <key>hero</key>

    <meta>
        <title lang="nl">Hero</title>
    </meta>

    <properties>

        <property name="eyebrow" type="text_line">
            <meta>
                <title lang="nl">Eyebrow tekst</title>
            </meta>
        </property>

        <property name="title" type="text_editor" mandatory="true">
            <meta>
                <title lang="nl">Titel</title>
            </meta>
            <params>
                <param name="toolbar" type="collection">
                    <param name="italic"/>
                </param>
            </params>
        </property>

        <property name="subtitle" type="text_area">
            <meta>
                <title lang="nl">Subtitel</title>
            </meta>
        </property>

        <property name="background_image" type="single_media_selection">
            <meta>
                <title lang="nl">Achtergrondafbeelding</title>
            </meta>
            <params>
                <param name="types" value="image"/>
            </params>
        </property>

        <property name="buttons" type="block" mandatory="false">
            <meta>
                <title lang="nl">Knoppen (max 2)</title>
            </meta>
            <types>
                <type ref="button"/>
            </types>
        </property>

    </properties>

</template>
