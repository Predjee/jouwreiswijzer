<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template">

    <key>request_form</key>

    <meta>
        <title lang="nl">Aanvraagformulier</title>
    </meta>

    <properties>
        <property name="form" type="single_form_selection" mandatory="true">
            <meta>
                <title lang="nl">Formulier</title>
            </meta>
            <params>
                <param name="resourceKey" value="page"/>
            </params>
        </property>

        <property name="display_mode" type="single_select">
            <meta>
                <title lang="nl">Weergave</title>
            </meta>
            <params>
                <param name="default_value" value="inline"/>
                <param name="values" type="collection">
                    <param name="inline">
                        <meta>
                            <title lang="nl">Inline</title>
                        </meta>
                    </param>
                    <param name="modal">
                        <meta>
                            <title lang="nl">Modal</title>
                        </meta>
                    </param>
                </param>
            </params>
        </property>

        <property name="modal_button_label" type="text_line"
                  visibleCondition="__parent.display_mode == 'modal'">
            <meta>
                <title lang="nl">Tekst op knop</title>
            </meta>
        </property>

        <property name="title" type="text_editor">
            <meta>
                <title lang="nl">Titel</title>
            </meta>
            <params>
                <param name="toolbar" type="collection">
                    <param name="italic"/>
                </param>
            </params>
        </property>

        <property name="intro" type="text_editor">
            <meta>
                <title lang="nl">Introductietekst</title>
            </meta>
        </property>
    </properties>

</template>
