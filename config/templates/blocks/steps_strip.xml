<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template">

    <key>steps_strip</key>

    <meta>
        <title lang="nl">Stappenstrip</title>
    </meta>

    <properties>

        <property name="steps" type="block" mandatory="true">
            <meta>
                <title lang="nl">Stappen</title>
            </meta>
            <types>
                <type name="step">
                    <meta>
                        <title lang="nl">Stap</title>
                    </meta>
                    <properties>

                        <property name="label" type="text_line" mandatory="true">
                            <meta>
                                <title lang="nl">Staplabel</title>
                            </meta>
                        </property>

                        <property name="description" type="text_line">
                            <meta>
                                <title lang="nl">Korte omschrijving</title>
                            </meta>
                        </property>

                    </properties>
                </type>
            </types>
        </property>

    </properties>

</template>
