<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template
          http://schemas.sulu.io/template/template-1.0.xsd">

    <key>aanvraag</key>
    <view>pages/aanvraag</view>
    <controller>Sulu\Content\UserInterface\Controller\Website\ContentController::indexAction</controller>
    <cacheLifetime>0</cacheLifetime>

    <meta>
        <title lang="nl">Aanvraagpagina</title>
    </meta>

    <properties>
        <property name="title" type="text_line" mandatory="true">
            <meta><title lang="nl">Titel</title></meta>
            <params><param name="headline" value="true"/></params>
            <tag name="sulu.rlp.part"/>
        </property>

        <property name="url" type="route" mandatory="true">
            <meta><title lang="nl">URL</title></meta>
            <tag name="sulu.rlp"/>
        </property>

        <property name="intro" type="text_editor">
            <meta><title lang="nl">Introductietekst</title></meta>
        </property>

        <property name="form" type="single_form_selection">
            <meta><title lang="nl">Formulier</title></meta>
            <params>
                <param name="resourceKey" value="page"/>
            </params>
        </property>

        <section name="content">
            <meta>
                <title lang="nl">Content blokken</title>
            </meta>
            <properties>
                <property name="blocks" type="block" mandatory="false">
                    <meta>
                        <title lang="nl">Paginablokken</title>
                    </meta>
                    <params>
                        <param name="settings_form_key" value="content_block_settings"/>
                    </params>
                    <types>
                        <type ref="request_form"/>
                    </types>
                </property>
            </properties>
        </section>
    </properties>
</template>
