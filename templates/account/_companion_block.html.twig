{% set mode = mode|default('compact') %}
{% set block_labels = {
    destination: 'Bestemming',
    route_overview: 'Route',
    practical_info: 'Praktisch',
    checklist: 'Checklist',
    budget_note: 'Budget',
    personal_note: 'Notitie',
    free_text: 'Info',
    activity: 'Activiteit',
    accommodation: 'Verblijf',
    transport: 'Vervoer',
    meal: 'Eten',
    tip: 'Tip',
    note: 'Notitie'
} %}
{% set block_label = block_labels[block.type]|default(block.type|replace({'_': ' '})|title) %}
{% set block_title = block.title ?: block_label %}
{% set time_badge = block.timeRangeLabel ?: block.timeLabel %}

{% if mode == 'spotlight' %}
    <article class="account-companion-unit account-companion-unit--spotlight account-companion-unit--{{ block.type }}" id="{{ block_id|default(block.type) }}">
        <div class="account-companion-now-time">
            <span>{{ time_badge ?: 'Nu' }}</span>
            <em>{{ block.timeRangeLabel and block.timeLabel ? block.timeLabel : block_label }}</em>
        </div>
        <div class="account-companion-now-body">
            <h2>{{ block_title }}</h2>
            {% if block.location %}
                <p class="account-companion-place">{{ block.location }}</p>
            {% endif %}
            {% if block.text %}
                <div class="account-companion-snippet">{{ block.text|raw }}</div>
            {% endif %}
            {% if block.routeStops is not empty %}
                <ol class="account-companion-mini-route">
                    {% for stop in block.routeStops|slice(0, 3) %}
                        <li>
                            <strong>{{ stop.title ?: stop.location }}</strong>
                            {% if stop.location and stop.title %}
                                <span>{{ stop.location }}</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
            <div class="account-companion-actions-inline">
                {% if block.mapsUrl %}
                    <a href="{{ block.mapsUrl }}">Kaart</a>
                {% endif %}
                {% if block.bookingUrl %}
                    <a href="{{ block.bookingUrl }}">Details</a>
                {% endif %}
                {% if day is defined %}
                    <a href="{{ path('account_companion_day', {id: trip.id, dayNumber: day.dayNumber}) }}">Dag openen</a>
                {% endif %}
            </div>
        </div>
    </article>
{% elseif mode == 'checklist' %}
    {% set checklist_total = block.checklistItems|length %}
    {% set checklist_done = block.checklistItems|filter(item => item.checked)|length %}
    {% set checklist_percent = checklist_total > 0 ? (checklist_done / checklist_total * 100)|round(0, 'floor') : 0 %}

    <article class="account-companion-unit account-companion-unit--checklist" id="{{ block_id|default(block.type) }}">
        <div class="account-companion-module-head">
            <div>
                <span>{{ block_label }}</span>
                <h2>{{ block_title }}</h2>
            </div>
            <strong>{{ checklist_done }}/{{ checklist_total }}</strong>
        </div>
        <div class="account-companion-progress-bar" aria-hidden="true">
            <span style="width: {{ checklist_percent }}%"></span>
        </div>
        <div class="account-companion-checklist" data-controller="companion-checklist">
            {% for item in block.checklistItems %}
                <form
                    method="post"
                    action="{{ path('account_companion_checklist_toggle', {id: trip.id, itemKey: item.key}) }}"
                    class="account-companion-checklist-item {{ item.checked ? 'is-checked' : '' }}"
                    data-action="submit->companion-checklist#toggle"
                >
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_companion_checklist_' ~ trip.id) }}">
                    <button type="submit" aria-pressed="{{ item.checked ? 'true' : 'false' }}">
                        <span aria-hidden="true"></span>
                        {{ item.label }}
                    </button>
                </form>
            {% endfor %}
        </div>
    </article>
{% elseif mode == 'info' %}
    {% set summary_count = 0 %}
    {% if block.text %}
        {% set summary_count = summary_count + 1 %}
    {% endif %}
    {% if block.location %}
        {% set summary_count = summary_count + 1 %}
    {% endif %}
    {% if block.routeStops is not empty %}
        {% set summary_count = summary_count + block.routeStops|length %}
    {% endif %}

    <article class="account-companion-unit account-companion-unit--info account-companion-unit--{{ block.type }}" id="{{ block_id|default(block.type) }}">
        <details class="account-companion-info-details">
            <summary>
                <span>{{ block_label }}</span>
                <strong>{{ block_title }}</strong>
                <em>{{ summary_count > 0 ? summary_count ~ ' onderwerpen' : 'Openen' }}</em>
            </summary>
            <div class="account-companion-info-body">
                {% if block.location %}
                    <p class="account-companion-place">{{ block.location }}</p>
                {% endif %}
                {% if block.text %}
                    <div class="account-companion-rich-text">{{ block.text|raw }}</div>
                {% endif %}
                {% if block.routeStops is not empty %}
                    <ol class="account-companion-mini-route">
                        {% for stop in block.routeStops %}
                            <li>
                                <strong>{{ stop.title ?: stop.location }}</strong>
                                {% if stop.location and stop.title %}
                                    <span>{{ stop.location }}</span>
                                {% endif %}
                                {% if stop.text %}
                                    <p>{{ stop.text|raw }}</p>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ol>
                {% endif %}
                <div class="account-companion-actions-inline">
                    {% if block.mapsUrl %}
                        <a href="{{ block.mapsUrl }}">Kaart</a>
                    {% endif %}
                    {% if block.bookingUrl %}
                        <a href="{{ block.bookingUrl }}">Details</a>
                    {% endif %}
                </div>
            </div>
        </details>
    </article>
{% else %}
    <article class="account-companion-unit account-companion-unit--compact account-companion-unit--{{ block.type }}" id="{{ block_id|default(block.type) }}">
        <div class="account-companion-compact-time">
            <span>{{ time_badge ?: block_label }}</span>
        </div>
        <div class="account-companion-compact-body">
            <h2>{{ block_title }}</h2>
            {% if block.location %}
                <p class="account-companion-place">{{ block.location }}</p>
            {% endif %}
            {% if block.text %}
                <div class="account-companion-snippet">{{ block.text|raw }}</div>
            {% endif %}
            {% if block.routeStops is not empty %}
                <ol class="account-companion-mini-route">
                    {% for stop in block.routeStops|slice(0, 2) %}
                        <li>
                            <strong>{{ stop.title ?: stop.location }}</strong>
                            {% if stop.location and stop.title %}
                                <span>{{ stop.location }}</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
            <div class="account-companion-actions-inline">
                {% if block.mapsUrl %}
                    <a href="{{ block.mapsUrl }}">Kaart</a>
                {% endif %}
                {% if block.bookingUrl %}
                    <a href="{{ block.bookingUrl }}">Details</a>
                {% endif %}
            </div>
        </div>
    </article>
{% endif %}
