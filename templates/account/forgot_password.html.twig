{% extends 'account/base.html.twig' %}

{% block content %}
    <section class="account-login-section">
        <div class="account-login-shell">
            <div class="account-login-intro">
                <p class="type-kicker">Mijn Omgeving</p>
                <h1 class="type-section-title">Wachtwoord vergeten</h1>
                <p class="type-body">
                    Vul je e-mailadres in. Als het bekend is, sturen we je een link om je wachtwoord opnieuw in te stellen.
                </p>
            </div>

            <div class="account-login-card">
                {% if submitted %}
                    <p class="account-profile-success" role="status">
                        Als dit e-mailadres bekend is, ontvang je een link om je wachtwoord opnieuw in te stellen.
                    </p>
                {% endif %}

                <form method="post" action="{{ path('account_forgot_password') }}" class="account-login-form">
                    <div class="account-field">
                        <label for="email" class="account-label">E-mailadres</label>
                        <input
                            id="email"
                            name="email"
                            type="email"
                            value="{{ email }}"
                            autocomplete="email"
                            required
                            autofocus
                            class="account-input"
                        >
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_forgot_password') }}">

                    <button type="submit" class="btn-primary account-submit">Resetlink aanvragen</button>
                </form>
            </div>
        </div>
    </section>
{% endblock %}
