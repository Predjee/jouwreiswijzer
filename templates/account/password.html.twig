{% extends 'base.html.twig' %}

{% block content %}
    <section class="account-profile-section">
        <div class="account-profile-shell account-password-shell">
            <div class="account-profile-header">
                <div>
                    <p class="type-kicker">Mijn Omgeving</p>
                    <h1 class="type-section-title">Wachtwoord wijzigen</h1>
                    <p class="type-body">Kies een nieuw wachtwoord van minimaal acht tekens.</p>
                </div>
                <a href="{{ path('account') }}" class="btn-ghost">Mijn reisplannen</a>
            </div>

            {% for message in app.flashes('account_password_success') %}
                <p class="account-profile-success" role="status">{{ message }}</p>
            {% endfor %}

            <form method="post" action="{{ path('account_password') }}" class="account-profile-card">
                <div class="account-password-fields">
                    <div class="account-field">
                        <label for="currentPassword" class="account-label">Huidig wachtwoord</label>
                        <input
                            id="currentPassword"
                            name="currentPassword"
                            type="password"
                            autocomplete="current-password"
                            required
                            class="account-input {{ errors.currentPassword is defined ? 'account-input--error' : '' }}"
                        >
                        {% if errors.currentPassword is defined %}
                            <p class="account-field-error">{{ errors.currentPassword }}</p>
                        {% endif %}
                    </div>

                    <div class="account-field">
                        <label for="newPassword" class="account-label">Nieuw wachtwoord</label>
                        <input
                            id="newPassword"
                            name="newPassword"
                            type="password"
                            autocomplete="new-password"
                            minlength="8"
                            required
                            class="account-input {{ errors.newPassword is defined ? 'account-input--error' : '' }}"
                        >
                        {% if errors.newPassword is defined %}
                            <p class="account-field-error">{{ errors.newPassword }}</p>
                        {% endif %}
                    </div>

                    <div class="account-field">
                        <label for="confirmPassword" class="account-label">Bevestig nieuw wachtwoord</label>
                        <input
                            id="confirmPassword"
                            name="confirmPassword"
                            type="password"
                            autocomplete="new-password"
                            minlength="8"
                            required
                            class="account-input {{ errors.confirmPassword is defined ? 'account-input--error' : '' }}"
                        >
                        {% if errors.confirmPassword is defined %}
                            <p class="account-field-error">{{ errors.confirmPassword }}</p>
                        {% endif %}
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_password') }}">

                <button type="submit" class="btn-primary account-profile-submit">
                    Wachtwoord wijzigen
                </button>
            </form>
        </div>
    </section>
{% endblock %}
