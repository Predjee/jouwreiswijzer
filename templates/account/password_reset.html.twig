{% extends 'base.html.twig' %}

{% block content %}
    <section class="account-login-section">
        <div class="account-login-shell">
            <div class="account-login-intro">
                <p class="type-kicker">Mijn Omgeving</p>
                <h1 class="type-section-title">Wachtwoord instellen</h1>
                <p class="type-body">Kies een wachtwoord van minimaal acht tekens.</p>
            </div>

            <div class="account-login-card">
                {% if invalid_token|default(false) %}
                    <p class="account-login-error" role="alert">
                        Deze link is ongeldig of verlopen. Neem contact met ons op voor een nieuwe uitnodiging.
                    </p>
                {% elseif password_reset|default(false) %}
                    <p class="account-profile-success" role="status">
                        Je wachtwoord is ingesteld. Je kunt nu inloggen.
                    </p>
                    <a href="{{ path('account_login') }}" class="btn-primary account-submit">Naar inloggen</a>
                {% else %}
                    {% if errors is not empty %}
                        <p class="account-form-error-summary" role="alert">Opslaan is niet gelukt. Controleer de gemarkeerde velden.</p>
                    {% endif %}

                    <form method="post" action="{{ path('account_password_reset', {token: token}) }}" class="account-login-form" novalidate>
                        <div class="account-field">
                            <label for="newPassword" class="account-label">Nieuw wachtwoord</label>
                            <input
                                id="newPassword"
                                name="newPassword"
                                type="password"
                                autocomplete="new-password"
                                minlength="8"
                                required
                                autofocus
                                {% if errors.newPassword is defined %}aria-invalid="true"{% endif %}
                                class="account-input {{ errors.newPassword is defined ? 'account-input--error' : '' }}"
                            >
                            {% if errors.newPassword is defined %}
                                <p class="account-field-error">{{ errors.newPassword }}</p>
                            {% endif %}
                        </div>

                        <div class="account-field">
                            <label for="confirmPassword" class="account-label">Bevestig wachtwoord</label>
                            <input
                                id="confirmPassword"
                                name="confirmPassword"
                                type="password"
                                autocomplete="new-password"
                                minlength="8"
                                required
                                {% if errors.confirmPassword is defined %}aria-invalid="true"{% endif %}
                                class="account-input {{ errors.confirmPassword is defined ? 'account-input--error' : '' }}"
                            >
                            {% if errors.confirmPassword is defined %}
                                <p class="account-field-error">{{ errors.confirmPassword }}</p>
                            {% endif %}
                        </div>

                        <input
                            type="hidden"
                            name="_csrf_token"
                            value="{{ csrf_token('account_password_reset_' ~ token) }}"
                        >

                        <button type="submit" class="btn-primary account-submit">Wachtwoord instellen</button>
                    </form>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
