<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% block meta %}
        {% set seo_title = extension.seo.title|default(content.title|default('Jouw ReisWijzer - Persoonlijk reisadvies op maat'))|replace({
            'JouwReiswijzer': 'Jouw ReisWijzer',
            'Jouw Reiswijzer': 'Jouw ReisWijzer',
        }) %}
        {% set seo = extension.seo|default([])|merge({ title: seo_title }) %}
        {% set seo_description = extension.seo.description|default('Persoonlijk reisadvies voor een onvergetelijke reis.') %}
        {{ include('@SuluWebsite/Extension/seo.html.twig', {
            seo: seo,
            content: content|default([]),
            localizations: localizations|default([]),
            shadowBaseLocale: shadowBaseLocale|default(),
        }) }}
        {% if not extension.seo.description|default %}
            <meta name="description" content="Persoonlijk reisadvies op maat, zorgvuldig samengesteld rond jouw wensen, tempo en budget.">
        {% endif %}
        <meta property="og:title" content="{{ seo_title }}">
        <meta property="og:description" content="{{ seo_description }}">
        <meta property="og:type" content="website">
        <meta property="og:url" content="{{ app.request.uri }}">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ seo_title }}">
        <meta name="twitter:description" content="{{ seo_description }}">
        <meta name="application-name" content="Jouw ReisWijzer">
        <meta name="apple-mobile-web-app-title" content="Jouw ReisWijzer">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <meta name="theme-color" content="#07141d">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('images/apple-touch-icon.png') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/favicon-32x32.png') }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('images/favicon-16x16.png') }}">
        <link rel="shortcut icon" href="{{ asset('images/favicon.ico') }}">
        <link rel="manifest" href="{{ path('site_webmanifest') }}">
    {% endblock %}

    {% block style %}
        <link rel="stylesheet" href="{{ asset('styles/account.css') }}">
    {% endblock %}

    {{ importmap('app') }}
</head>
<body class="bg-navy-deepest text-content-primary font-body antialiased
             min-h-screen flex flex-col"
      data-controller="cookie-consent scroll-reveal">

<a href="#main-content" class="skip-link">Direct naar de inhoud</a>

<header class="relative z-20">
    {% block header %}
        {{ include('components/_nav.html.twig') }}
    {% endblock %}
</header>

<main id="main-content" class="flex-1" tabindex="-1">
    {% block content %}{% endblock %}
</main>

{% block footer %}
    {{ include('components/_footer.html.twig') }}
{% endblock %}

{% block javascripts %}{% endblock %}

</body>
</html>
