<section class="section block-cta-banner relative overflow-hidden">

    {% include 'components/_decor.html.twig' with { block: block } %}

    <div class="cta-banner-content relative z-10 flex flex-col gap-5">
        <h2 class="type-section-title">
            {{ block.title|striptags('<em><i>')|raw }}
        </h2>

        {% if block.body|default %}
            <p class="type-body">
                {{ block.body }}
            </p>
        {% endif %}

        {% if block.trust_items|default %}
            <ul class="flex flex-wrap gap-x-5 gap-y-3">
                {% for item in block.trust_items|split('\n') %}
                    {% if item|trim %}
                        <li class="type-meta flex items-center gap-2">
                            <span class="cta-banner-trust-icon" aria-hidden="true">✦</span>
                            {{ item|trim }}
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        {% endif %}

        {% if block.buttons|default %}
            <div class="cta-banner-actions flex flex-col gap-4 sm:flex-row">
                {% for button in block.buttons %}
                    {{ include('components/_button.html.twig', {
                        button: button,
                        class: 'shrink-0',
                    }) }}
                {% endfor %}
            </div>
        {% endif %}

    </div>

</section>
