<section class="block-hero relative flex items-center overflow-hidden min-h-[520px] md:min-h-[580px] lg:h-[620px]">

    <div class="hero-grain" aria-hidden="true"></div>

    {{ include('components/_sparkle_hero.html.twig') }}

    <div class="relative z-10 px-5 pb-10 pt-16 w-full
                md:px-10 md:pt-20 md:max-w-[480px]
                lg:pl-[52px] lg:pr-0 lg:pb-10 lg:max-w-[500px]">

        {% if block.eyebrow|default %}
            <p class="flex items-center gap-3 mb-5
                      font-body font-light text-[10px] tracking-[0.3em]
                      uppercase text-gold">
                <span class="block w-7 h-px bg-gold shrink-0"
                      aria-hidden="true"></span>
                {{ block.eyebrow }}
            </p>
        {% endif %}

        <h1 class="hero-title font-display font-light leading-[1.07]
                   text-content-primary mb-4
                   text-[38px] md:text-[48px] lg:text-[56px]">
            {{ block.title }}
            {% if block.title_italic|default %}
                <em class="not-italic text-gold">
                    {{ block.title_italic }}
                </em>
            {% endif %}
        </h1>

        {% if block.subtitle|default %}
            <p class="font-body font-light text-sm leading-[1.85]
                      text-content-secondary mb-8
                      md:max-w-[380px]">
                {{ block.subtitle }}
            </p>
        {% endif %}

        {% if block.buttons|default %}
            <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-7">
                {% for button in block.buttons %}
                    {{ include('components/_button.html.twig', {button: button}) }}
                {% endfor %}
            </div>
        {% endif %}

    </div>

    {% if block.scroll_label|default %}
        <div class="absolute bottom-7 left-1/2 -translate-x-1/2 z-10
                    flex flex-col items-center gap-2">
            <div class="w-px h-7 bg-gradient-to-b from-gold/70 to-transparent
                        animate-pulse"
                 aria-hidden="true"></div>
            <span class="font-body text-[10px] tracking-[0.2em] uppercase
                         text-content-primary bg-navy-deepest/60
                         px-3 py-1 border border-gold/20">
                {{ block.scroll_label }}
            </span>
        </div>
    {% endif %}

</section>
