<section class="block-hero relative overflow-hidden
                {{ block.background_image ? 'block-hero--image' : '' }}
                {{ block.size|default('full') == 'compact' ? 'block-hero--compact' : '' }}">

    {% if block.background_image %}
        {% set hero_bg = block.background_image.thumbnails['hero-bg']|default(block.background_image.url|default('')) %}
        {% set hero_bg_sm = block.background_image.thumbnails['hero-bg-sm']|default(hero_bg) %}
        {% set hero_bg_md = block.background_image.thumbnails['hero-bg-md']|default(hero_bg) %}
        {% set hero_bg_lg = block.background_image.thumbnails['hero-bg-lg']|default(hero_bg) %}
        <img src="{{ hero_bg }}"
             srcset="{{ hero_bg_sm }} 768w,
                     {{ hero_bg_md }} 1280w,
                     {{ hero_bg_lg }} 1600w,
                     {{ hero_bg }} 1920w"
             sizes="100vw"
             alt=""
             role="presentation"
             loading="eager"
             decoding="async"
             fetchpriority="high"
             class="hero-bg-image absolute inset-0 w-full h-full object-cover object-center">
    {% endif %}

    {% include 'components/_decor.html.twig' with { block: block } %}

    <span class="hero-grain" aria-hidden="true"></span>

    <header class="hero-copy relative z-10 flex w-full flex-col gap-5
                   px-5 pb-10 pt-16
                   md:px-10 md:pt-20
                   lg:pl-[52px] lg:pr-0 lg:pb-10">

        {% if block.eyebrow|default %}
            <p class="section-label">
                {{ block.eyebrow }}
            </p>
        {% endif %}

        {% set safe_title = block.title|striptags('<em><i>') %}
        {% if heading_tag|default('h2') == 'h1' %}
            <h1 class="hero-title type-hero-title">{{ safe_title|raw }}</h1>
        {% else %}
            <h2 class="hero-title type-hero-title">{{ safe_title|raw }}</h2>
        {% endif %}

        {% if block.subtitle|default %}
            <p class="type-body">
                {{ block.subtitle }}
            </p>
        {% endif %}

        {% if block.buttons|default %}
            <div class="flex flex-col gap-4 pt-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-7">
                {% for button in block.buttons %}
                    {{ include('components/_button.html.twig', { button: button }) }}
                {% endfor %}
            </div>
        {% endif %}

        {% if block.micro_usps|default %}
            <ul class="hero-micro-usps flex flex-wrap gap-4 pt-2" role="list">
                {% for usp in block.micro_usps %}
                    {% if usp.label|default %}
                        <li class="hero-micro-usp flex items-center gap-2 type-meta">
                            <svg class="hero-micro-usp__icon"
                                 viewBox="0 0 16 16"
                                 fill="none"
                                 aria-hidden="true"
                                 focusable="false">
                                <path d="M13.5 4.25 6.5 11.25 2.75 7.5"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"/>
                            </svg>
                            {{ usp.label }}
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        {% endif %}

    </header>

    <span class="hero-scroll-line pointer-events-none absolute bottom-7 left-1/2 z-10
                 -translate-x-1/2"
          aria-hidden="true"></span>

</section>
