<section class="section block-intro-two-col relative overflow-hidden">

    {% include 'components/_decor.html.twig' with { block: block } %}

    <div class="relative z-10 grid grid-cols-1 items-center gap-11
                lg:grid-cols-2 lg:gap-[72px]">

        <div class="flex flex-col gap-5">
            {{ include('components/_section_label.html.twig', {
                label: block.label|default,
            }) }}
            {{ include('components/_section_title.html.twig', {
                title: block.title|raw,
            }) }}
            {% if block.body|default %}
                <div class="type-body section-copy">
                    {{ block.body|raw }}
                </div>
            {% endif %}
        </div>

        {% if block.quote|default %}
            <blockquote class="intro-two-col-quote flex flex-col gap-4">
                <p class="type-quote">
                    “{{ block.quote }}”
                </p>
                {% if block.quote_author|default %}
                    <cite class="intro-two-col-cite type-kicker not-italic">
                        — {{ block.quote_author }}
                    </cite>
                {% endif %}
            </blockquote>
        {% endif %}

    </div>

</section>
