<section class="block-intro-two-col relative overflow-hidden
                px-5 py-12
                md:px-10 md:py-16
                lg:px-[52px] lg:py-[62px]">

    <svg class="deco-svg absolute right-0 top-1/2 -translate-y-1/2 pointer-events-none"
         style="width:200px; height:160px; opacity:0.07;"
         viewBox="0 0 200 160" fill="none"
         aria-hidden="true">
        <polyline
            points="0,160 0,110 15,110 15,90 25,90 25,70 35,70 35,85
                    50,85 50,60 58,60 58,45 66,45 66,30 74,30 74,45
                    82,45 82,55 95,55 95,75 108,75 108,50 116,50 116,65
                    128,65 128,80 140,80 140,60 150,60 150,75 162,75
                    162,85 175,85 175,100 185,100 185,110 200,110 200,160"
            stroke="var(--color-gold)"
            stroke-width="1.2"
            fill="var(--color-gold-08)"/>
        <line x1="70" y1="30" x2="70" y2="18"
              stroke="var(--color-gold)" stroke-width="0.8"/>
        <circle cx="70" cy="17" r="1.5" fill="var(--color-gold)"/>
        <rect x="52" y="52" width="3" height="3" fill="var(--color-gold)" opacity="0.6"/>
        <rect x="52" y="60" width="3" height="3" fill="var(--color-gold)" opacity="0.5"/>
        <rect x="68" y="36" width="3" height="3" fill="var(--color-gold)" opacity="0.7"/>
        <rect x="68" y="44" width="3" height="3" fill="var(--color-gold)" opacity="0.5"/>
        <rect x="110" y="56" width="3" height="3" fill="var(--color-gold)" opacity="0.5"/>
        <rect x="142" y="66" width="3" height="3" fill="var(--color-gold)" opacity="0.45"/>
    </svg>

    <div class="grid grid-cols-1 gap-10 items-center relative z-10
                lg:grid-cols-2 lg:gap-[60px]">

        <div>
            {{ include('components/_section_label.html.twig', {
                label: block.label|default,
            }) }}
            {{ include('components/_section_title.html.twig', {
                title: block.title,
                title_italic: block.title_italic|default,
            }) }}
            {% if block.body|default %}
                <div class="font-body font-light text-[13px] leading-[1.85]
                            text-content-muted">
                    {{ block.body|raw }}
                </div>
            {% endif %}
        </div>

        {% if block.quote|default %}
            <blockquote class="border-l border-gold/30 pl-5 lg:pl-[22px]">
                <p class="font-display font-light italic leading-[1.5]
                          text-content-secondary mb-3.5
                          text-[18px] lg:text-[20px]">
                    "{{ block.quote }}"
                </p>
                {% if block.quote_author|default %}
                    <cite class="font-body font-light text-[10px]
                                 tracking-[0.14em] uppercase not-italic
                                 text-content-dim">
                        — {{ block.quote_author }}
                    </cite>
                {% endif %}
            </blockquote>
        {% endif %}

    </div>

</section>
