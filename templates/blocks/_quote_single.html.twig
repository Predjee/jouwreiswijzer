<section class="section block-quote-single relative overflow-hidden">

    {% include 'components/_decor.html.twig' with { block: block } %}

    {% if block.quote|default %}
        <blockquote class="quote-single-content relative z-10 flex max-w-full flex-col gap-6">
            <p class="type-quote">
                “{{ block.quote }}”
            </p>
            {% if block.author|default %}
                <cite class="quote-single-cite type-kicker not-italic">
                    — {{ block.author }}
                </cite>
            {% endif %}
        </blockquote>
    {% endif %}
</section>
