{% set block_index = loop.index0|default(0) %}
{% set instance_id = 'request-form-' ~ resource.id ~ '-' ~ block_index %}
{% set form_name = 'request_form_' ~ block_index %}
{% set display_mode = block.display_mode|default('inline') %}
{% set selected_form = block.form|default(null) %}
{% set block_view = view.blocks[block_index]|default({}) %}
{% set form_view = selected_form ? (selected_form.vars is defined ? selected_form : sulu_form_get_by_id(selected_form, 'page', resource.id, null, form_name)) : null %}
{% set success_text = block_view.form.entity.successText|default(null) %}

{% if form_view %}
    {% form_theme form_view 'form/theme.html.twig' %}

    <section class="section block-request-form relative overflow-hidden"
             data-controller="request-form"
             data-request-form-instance="{{ instance_id }}">

        {% include 'components/_decor.html.twig' with {block: block} %}

        <div class="request-form-shell relative z-10">
            {% if block.title|default or block.intro|default %}
                <div class="request-form-copy">
                    {% if block.title|default %}
                        <h2 class="type-section-title">{{ block.title|striptags('<em><i>')|raw }}</h2>
                    {% endif %}

                    {% if block.intro|default %}
                        <div class="type-body">{{ block.intro|raw }}</div>
                    {% endif %}
                </div>
            {% endif %}

            {% if display_mode == 'modal' %}
                <button type="button"
                        class="btn-primary request-form-open"
                        data-action="request-form#open">
                    {{ block.modal_button_label|default('Start je aanvraag') }}
                </button>

                <dialog class="request-form-modal"
                        aria-label="Aanvraagformulier"
                        data-request-form-target="modal"
                        data-action="click->request-form#closeOnBackdrop">
                    <div class="request-form-modal-content">
                        <button type="button"
                                class="request-form-modal-close"
                                aria-label="Sluit aanvraagformulier"
                                data-action="request-form#close">
                            <span aria-hidden="true">&times;</span>
                        </button>

                        <div class="request-form-modal-heading">
                            <p class="type-kicker">Aanvraag</p>
                            <p class="type-section-title">Vertel ons over je reis</p>
                        </div>

                        <div class="request-form-panel"
                             data-request-form-target="formContainer"
                             {% if success_text %}
                                 data-request-form-success-text="{{ success_text|e('html_attr') }}"
                             {% endif %}>
                            {{ form(form_view, {
                                attr: {
                                    'data-action': 'submit->request-form#submit',
                                },
                            }) }}
                            <p class="type-meta mt-4">
                                Met je aanvraag ga je akkoord met het verwerken van je gegevens volgens het
                                <a href="/privacybeleid" class="footer-link">privacybeleid</a>.
                            </p>
                        </div>
                    </div>
                </dialog>
            {% else %}
                <div class="request-form-panel"
                     data-request-form-target="formContainer"
                     {% if success_text %}
                         data-request-form-success-text="{{ success_text|e('html_attr') }}"
                     {% endif %}>
                    {{ form(form_view, {
                        attr: {
                            'data-action': 'submit->request-form#submit',
                        },
                    }) }}
                    <p class="type-meta mt-4">
                        Met je aanvraag ga je akkoord met het verwerken van je gegevens volgens het
                        <a href="/privacybeleid" class="footer-link">privacybeleid</a>.
                    </p>
                </div>
            {% endif %}
        </div>
    </section>
{% endif %}
