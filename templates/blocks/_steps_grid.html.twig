<section class="block-steps-grid relative overflow-hidden
                px-5 py-12
                md:px-10 md:py-16
                lg:px-[52px] lg:py-[62px]">

    {# Bergketen deco links — alleen desktop #}
    <svg class="deco-svg absolute left-0 bottom-0 pointer-events-none"
         style="width:180px; height:140px; opacity:0.07;"
         viewBox="0 0 180 140" fill="none"
         aria-hidden="true">
        <polyline
            points="0,140 0,100 30,55 55,80 80,35 105,65 130,25 155,55 180,40 180,140"
            stroke="var(--color-gold)" stroke-width="1.2"
            fill="var(--color-gold-08)" stroke-linejoin="round"/>
        <polyline points="72,45 80,35 88,45"
                  stroke="var(--color-gold)" stroke-width="0.8"
                  stroke-linejoin="round" opacity="0.8"/>
        <polyline points="122,34 130,25 138,34"
                  stroke="var(--color-gold)" stroke-width="0.8"
                  stroke-linejoin="round" opacity="0.8"/>
    </svg>

    <div class="relative z-10">

        {{ include('components/_section_label.html.twig', {
            label: block.label|default,
        }) }}

        {{ include('components/_section_title.html.twig', {
            title: block.title,
            title_italic: block.title_italic ?? null,
            class: 'max-w-full lg:max-w-[400px]',
        }) }}

        {% if block.steps|default %}
            <div class="grid grid-cols-1 gap-px mt-8 sm:grid-cols-2 lg:grid-cols-3"
                 style="background: var(--color-gold-08);
                        border: 0.5px solid var(--color-gold-08);">

                {% for step in block.steps %}
                    <div class="step-gold-line-top relative
                                px-5 py-7 md:px-6 md:py-8
                                bg-navy-light">

                        <div class="font-display font-light leading-none mb-3
                                    text-[40px] text-gold/10 lg:text-[48px]">
                            {{ '%02d'|format(loop.index) }}
                        </div>

                        <h3 class="font-display font-normal text-[18px]
                                   text-content-primary mb-2.5">
                            {{ step.title }}
                        </h3>

                        <p class="font-body font-light text-[12px]
                                  leading-[1.75] text-content-muted">
                            {{ step.body }}
                        </p>

                    </div>
                {% endfor %}

            </div>
        {% endif %}

    </div>

</section>
