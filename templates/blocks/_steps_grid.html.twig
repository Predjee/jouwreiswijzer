<section class="section block-steps-grid relative overflow-hidden">

    {% include 'components/_decor.html.twig' with { block: block } %}

    <div class="relative z-10 flex flex-col gap-10">

        <header>
            {{ include('components/_section_label.html.twig', {
                label: block.label|default,
            }) }}

            {{ include('components/_section_title.html.twig', {
                title: block.title|raw,
            }) }}
        </header>

        {% if block.steps|default %}
            <ol class="steps-grid-list grid grid-cols-1 gap-px
                       sm:grid-cols-2 lg:grid-cols-3">

                {% for step in block.steps %}
                    <li class="steps-grid-item relative flex flex-col gap-3
                               px-5 py-7 md:px-7 md:py-9
                               {{ loop.last and loop.length is odd ? 'sm:col-span-2' : '' }}
                               {{ loop.last and loop.length % 3 == 1 ? 'lg:col-span-3' : '' }}
                               {{ loop.last and loop.length % 3 == 2 ? 'lg:col-span-2' : '' }}
                               {{ loop.last and loop.length % 3 == 0 ? 'lg:col-span-1' : '' }}">

                        <span class="type-step-number pb-1" aria-hidden="true">
                            {{ '%02d'|format(loop.index) }}
                        </span>

                        <h3 class="type-card-title">
                            {{ step.title }}
                        </h3>

                        <p class="type-body">
                            {{ step.body }}
                        </p>

                    </li>
                {% endfor %}

            </ol>
        {% endif %}

    </div>

</section>
