<section class="block-steps-strip" aria-label="Stappen">
    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">

        {% for step in block.steps|default([]) %}
            <li class="steps-strip-item flex items-center gap-4
                       border-b px-5 py-5 sm:border-b-0 md:px-7 md:py-6
                       {{ loop.last and loop.length is odd ? 'sm:col-span-2' : '' }}
                       {{ loop.last and loop.length % 4 == 1 ? 'lg:col-span-4' : '' }}
                       {{ loop.last and loop.length % 4 == 2 ? 'lg:col-span-3' : '' }}
                       {{ loop.last and loop.length % 4 == 3 ? 'lg:col-span-2' : '' }}
                       {{ not loop.last ? 'sm:border-r' : '' }}">

                <span class="type-step-number shrink-0" aria-hidden="true">
                    {{ '%02d'|format(loop.index) }}
                </span>

                <div class="flex flex-col gap-1">
                    <p class="type-kicker">
                        {{ step.label }}
                    </p>
                    {% if step.description|default %}
                        <p class="steps-strip-copy type-meta">
                            {{ step.description }}
                        </p>
                    {% endif %}
                </div>

            </li>
        {% endfor %}

    </ol>
</section>
