{% set layout = block.layout|default('text_only') %}

<section class="section block-text-media relative overflow-hidden">

    {% include 'components/_decor.html.twig' with { block: block } %}

    {% if layout == 'image_grid' %}
        {% set images = block.images|default([]) %}

        <div class="relative z-10 flex flex-col gap-8">
            {{ include('components/_section_label.html.twig', {
                label: block.label|default,
            }) }}

            {% if images %}
                <div class="text-media__grid
                            {{ images|length == 3 ? 'text-media__grid--three' : '' }}">
                    {% for image in images %}
                        {% set grid_image = image.thumbnails['text-media-grid']|default(image.url|default('')) %}
                        <figure class="text-media__grid-item">
                            <img src="{{ grid_image }}"
                                 alt="{{ image.title|default('') }}"
                                 width="640"
                                 height="480"
                                 loading="lazy"
                                 decoding="async">
                        </figure>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% else %}
        {% set has_image = layout in ['image_left', 'image_right'] and block.image|default %}

        <div class="text-media text-media--{{ layout|replace({'_': '-'}) }}
                    {{ has_image ? 'text-media--has-image' : '' }}
                    relative z-10">

            {% if has_image %}
                {% set landscape_image = block.image.thumbnails['text-media-landscape']|default(block.image.url|default('')) %}
                <figure class="text-media__media">
                    <img src="{{ landscape_image }}"
                         alt="{{ block.image.title|default('') }}"
                         width="960"
                         height="640"
                         loading="lazy"
                         decoding="async">
                    {% if block.image_caption|default %}
                        <figcaption class="text-media__caption">
                            {{ block.image_caption }}
                        </figcaption>
                    {% endif %}
                </figure>
            {% endif %}

            <div class="text-media__content flex flex-col gap-5">
                {{ include('components/_section_label.html.twig', {
                    label: block.label|default,
                }) }}

                {% if block.title|default %}
                    <h2 class="type-section-title">
                        {{ block.title|striptags('<em><i>')|raw }}
                    </h2>
                {% endif %}

                {% if block.body|default %}
                    <div class="type-body">
                        {{ block.body|raw }}
                    </div>
                {% endif %}

                {% if block.buttons|default %}
                    <div class="flex flex-col gap-4 pt-2 sm:flex-row sm:flex-wrap">
                        {% for button in block.buttons %}
                            {{ include('components/_button.html.twig', { button: button }) }}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

        </div>
    {% endif %}

</section>
