<section class="section block-travel-types-grid relative overflow-hidden">

    {% include 'components/_decor.html.twig' with { block: block } %}

    <div class="relative z-10 flex flex-col gap-10">

        <header>
            {{ include('components/_section_label.html.twig', {
                label: block.label|default,
            }) }}
            {{ include('components/_section_title.html.twig', {
                title: block.title|raw,
            }) }}
        </header>

        {% if block.cards|default %}
            <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">

                {% for card in block.cards %}
                    <li class="card-base flex flex-col gap-3
                               {{ loop.last and loop.length is odd ? 'sm:col-span-2' : '' }}
                               {{ loop.last and loop.length % 3 == 1 ? 'lg:col-span-3' : '' }}
                               {{ loop.last and loop.length % 3 == 2 ? 'lg:col-span-2' : '' }}
                               {{ loop.last and loop.length % 3 == 0 ? 'lg:col-span-1' : '' }}
                               {{ card.highlight|default ? 'card-base--highlight' : '' }}">

                        <p class="type-card-number">
                            — {{ '%02d'|format(loop.index) }}
                        </p>

                        <h3 class="type-card-title">
                            {{ card.title }}
                        </h3>

                        <p class="type-body pb-2">
                            {{ card.body }}
                        </p>

                        {% if card.tag|default %}
                            <span class="travel-type-tag type-tag self-start">
                                {{ card.tag }}
                            </span>
                        {% endif %}

                        <span class="travel-type-orbit" aria-hidden="true"></span>

                    </li>
                {% endfor %}

            </ul>
        {% endif %}
    </div>

</section>
