<section class="block-travel-types-grid relative overflow-hidden
                px-5 py-12
                md:px-10 md:py-16
                lg:px-[52px] lg:py-[62px]">

    <svg class="deco-svg absolute right-[-20px] top-1/2 -translate-y-1/2 pointer-events-none"
         style="width:170px; height:170px; opacity:0.06;"
         viewBox="0 0 180 180" fill="none"
         aria-hidden="true">
        <circle cx="90" cy="90" r="88" stroke="var(--color-gold)" stroke-width="0.8"/>
        <circle cx="90" cy="90" r="66" stroke="var(--color-gold)" stroke-width="0.4"/>
        <circle cx="90" cy="90" r="44" stroke="var(--color-gold)" stroke-width="0.3"/>
        <line x1="90" y1="2"   x2="90"  y2="178" stroke="var(--color-gold)" stroke-width="0.3"/>
        <line x1="2"  y1="90"  x2="178" y2="90"  stroke="var(--color-gold)" stroke-width="0.3"/>
        <line x1="28" y1="28"  x2="152" y2="152" stroke="var(--color-gold)" stroke-width="0.2"/>
        <line x1="152" y1="28" x2="28"  y2="152" stroke="var(--color-gold)" stroke-width="0.2"/>
        <polygon points="90,8  94,38  90,34  86,38"   fill="var(--color-gold)"/>
        <polygon points="90,172 94,142 90,146 86,142" fill="var(--color-gold)" opacity="0.5"/>
        <polygon points="8,90  38,94  34,90  38,86"   fill="var(--color-gold)" opacity="0.5"/>
        <polygon points="172,90 142,94 146,90 142,86" fill="var(--color-gold)" opacity="0.5"/>
        <circle cx="90" cy="90" r="5"   fill="var(--color-gold)"/>
        <circle cx="90" cy="90" r="2.5" fill="var(--color-navy-mid)"/>
    </svg>

    <div class="relative z-10">

        {{ include('components/_section_label.html.twig', {
            label: block.label|default,
        }) }}
        {{ include('components/_section_title.html.twig', {
            title: block.title,
            title_italic: block.title_italic|default,
            class: 'max-w-full lg:max-w-[400px]',
        }) }}

        {% if block.cards|default %}
            <div class="grid grid-cols-1 gap-3 mt-8
                        sm:grid-cols-2 lg:grid-cols-3">

                {% for card in block.cards %}
                    <div class="card-gold-line-top relative overflow-hidden
                                px-5 py-6 bg-navy-mid"
                         style="border: 0.5px solid
                         {{ card.highlight|default
                         ? 'var(--color-gold-30)'
                         : 'var(--color-gold-10)' }};">

                        <p class="font-display text-[11px] tracking-[0.15em] mb-2.5"
                           style="color: {{ card.highlight|default
                           ? 'var(--color-gold-30)'
                           : 'var(--color-gold-15)' }};">
                            — {{ '%02d'|format(loop.index) }}
                        </p>

                        <h3 class="font-display font-normal text-[17px]
                                   text-content-primary mb-1.5">
                            {{ card.title }}
                        </h3>

                        <p class="font-body font-light text-[12px]
                                  leading-[1.65] text-content-muted mb-3.5">
                            {{ card.body }}
                        </p>

                        {% if card.tag|default %}
                            <span class="font-body font-light text-[9px]
                                         tracking-[0.18em] uppercase border-b pb-0.5"
                                  style="color: {{ card.highlight|default
                                  ? 'var(--color-content-secondary)'
                                  : 'var(--color-gold)' }};
                                      border-color: {{ card.highlight|default
                                  ? 'var(--color-gold-20)'
                                  : 'var(--color-gold-15)' }};">
                                {{ card.tag }}
                            </span>
                        {% endif %}

                        <div class="absolute bottom-[-18px] right-[-18px]
                                    w-[70px] h-[70px] rounded-full"
                             style="border: 0.5px solid var(--color-gold-08);"
                             aria-hidden="true"></div>

                    </div>
                {% endfor %}

            </div>
        {% endif %}
    </div>

</section>
