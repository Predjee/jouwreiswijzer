{% set style = button.style ?? 'gold' %}
{% set extra_class = class|default('') %}
{% set resolved_url = button.link_type|default('page') == 'page' and button.page|default ? button.page.url|default('') : button.external_url|default('') %}

{% if button.label|default %}
    {% if style == 'gold' %}
        <a href="{{ resolved_url ?: '#' }}" class="btn-primary {{ extra_class }}">
            {{ button.label }}
        </a>
    {% else %}
        <a href="{{ resolved_url ?: '#' }}" class="btn-ghost {{ extra_class }}">
            {{ button.label }}
        </a>
    {% endif %}
{% endif %}
