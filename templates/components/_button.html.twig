{% set style = button.style ?? 'gold' %}
{% set extra_class = class|default('') %}

{% if button.label|default and button.url|default %}
    {% if style == 'gold' %}
        <a href="{{ button.url }}" class="btn-primary {{ extra_class }}">
            {{ button.label }}
        </a>
    {% else %}
        <a href="{{ button.url }}" class="btn-ghost {{ extra_class }}">
            {{ button.label }}
        </a>
    {% endif %}
{% endif %}
