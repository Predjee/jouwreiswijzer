<footer class="border-t" style="border-color: var(--color-gold-08); background: var(--color-navy-deepest);">

    <div class="px-5 py-10 md:px-10 lg:px-[52px]">

        <div class="grid grid-cols-1 gap-10 md:grid-cols-3 lg:grid-cols-4">

            <div class="md:col-span-1">
                <a href="{{ sulu_content_root_path() }}"
                   class="inline-block mb-4"
                   aria-label="JouwReiswijzer homepage">
                    <img src="{{ asset('images/logo.svg') }}"
                         alt="JouwReiswijzer"
                         width="200"
                         height="106"
                         class="h-[60px] w-auto opacity-90">
                </a>

                <p class="font-body font-light text-[12px] leading-[1.8]
                          text-content-dim max-w-[240px]">
                    Persoonlijk reisadvies op maat. Van eerste idee tot het laatste moment.
                </p>
            </div>

            <div>
                <h3 class="font-body font-light text-[9px] tracking-[0.24em]
                           uppercase text-gold mb-4">
                    Ontdekken
                </h3>
                <ul class="flex flex-col gap-3" role="list">
                    {% for item in sulu_page_navigation_root_tree('main', 1, {
                        title: 'title',
                        url: 'url',
                    }) %}
                        <li>
                            <a href="{{ sulu_content_path(item.url) }}"
                               class="font-body font-light text-[12px]
                                      text-content-dim hover:text-content-secondary
                                      transition-colors">
                                {{ item.title }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div>
                <h3 class="font-body font-light text-[9px] tracking-[0.24em]
                           uppercase text-gold mb-4">
                    Juridisch
                </h3>
                <ul class="flex flex-col gap-3" role="list">
                    <li>
                        <a href="/privacyverklaring"
                           class="font-body font-light text-[12px]
                                  text-content-dim hover:text-content-secondary
                                  transition-colors">
                            Privacyverklaring
                        </a>
                    </li>
                    <li>
                        <a href="/algemene-voorwaarden"
                           class="font-body font-light text-[12px]
                                  text-content-dim hover:text-content-secondary
                                  transition-colors">
                            Algemene voorwaarden
                        </a>
                    </li>
                </ul>
            </div>

            <div>
                <h3 class="font-body font-light text-[9px] tracking-[0.24em]
                           uppercase text-gold mb-4">
                    Direct contact
                </h3>
                <a href="/aanvragen"
                   class="inline-flex items-center gap-2
                          bg-gold text-navy-deepest
                          font-body font-medium text-[10px]
                          tracking-[0.22em] uppercase
                          px-6 py-3
                          transition-opacity hover:opacity-90">
                    Reis aanvragen
                </a>
            </div>

        </div>

        <div class="mt-10 pt-6 flex flex-col gap-2 sm:flex-row sm:justify-between
                    border-t"
             style="border-color: var(--color-gold-08);">
            <p class="font-body font-light text-[11px] tracking-[0.08em] text-content-dim">
                © {{ 'now'|date('Y') }} JouwReiswijzer. Alle rechten voorbehouden.
            </p>
            <p class="font-body font-light text-[11px] text-content-dim"
               style="color: var(--color-gold-20);">
                ✦
            </p>
        </div>

    </div>

</footer>
