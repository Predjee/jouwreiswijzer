{% set footer_snippet = sulu_snippet_load_by_area('footer', {
    tagline: 'tagline',
    navigation_title: 'navigation_title',
    legal_title: 'legal_title',
    legal_links: 'legal_links',
    contact_title: 'contact_title',
    cta_label: 'cta_label',
    cta_link: 'cta_link',
    copyright_text: 'copyright_text',
})|default({}) %}
{% set footer = {
    tagline: '',
    navigation_title: '',
    legal_title: '',
    legal_links: [],
    contact_title: '',
    cta_label: '',
    cta_link: '',
    copyright_text: '',
}|merge(footer_snippet ?: {}) %}
{% set footer_view = footer.view|default({}) %}
{% set legal_links_view = footer_view.legal_links|default([]) %}
{% set cta_link_view = footer_view.cta_link|default({}) %}
{% set footer_column_1 = sulu_page_navigation_root_tree('footer_column_1', 1, {
    title: 'title',
    url: 'url',
})|default([]) %}
{% set footer_column_2 = sulu_page_navigation_root_tree('footer_column_2', 1, {
    title: 'title',
    url: 'url',
})|default([]) %}
{% set footer_legal = sulu_page_navigation_root_tree('footer_legal', 1, {
    title: 'title',
    url: 'url',
})|default([]) %}

<footer class="site-footer border-t">

    <div class="flex flex-col gap-10 px-5 py-10 md:px-10 lg:px-[52px]">

        <div class="grid grid-cols-1 gap-10 md:grid-cols-3 lg:grid-cols-4">

            <div class="flex flex-col gap-4 md:col-span-1">
                <a href="{{ sulu_content_root_path() }}"
                   class="inline-block"
                   aria-label="Jouw ReisWijzer homepage">
                    <img src="{{ asset('images/logo.svg') }}"
                         alt="Jouw ReisWijzer"
                         width="200"
                         height="106"
                         loading="lazy"
                         class="footer-logo w-auto">
                </a>

                {% if footer.tagline|default %}
                    <p class="type-body max-w-[24rem]">
                        {{ footer.tagline }}
                    </p>
                {% endif %}
            </div>

            {% if footer.navigation_title or footer_column_1 %}
                <div class="flex flex-col gap-4">
                    {% if footer.navigation_title %}
                        <h2 class="type-kicker">
                            {{ footer.navigation_title }}
                        </h2>
                    {% endif %}
                    <ul class="flex flex-col gap-3" role="list">
                        {% for item in footer_column_1 %}
                            <li>
                                <a href="{{ sulu_content_path(item.url) }}"
                                   class="footer-link">
                                    {{ item.title }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% if footer.legal_title|default or footer_column_2 or footer.legal_links|default %}
                <div class="flex flex-col gap-4">
                    {% if footer.legal_title|default %}
                        <h2 class="type-kicker">
                            {{ footer.legal_title }}
                        </h2>
                    {% endif %}
                    {% if footer_column_2 %}
                        <ul class="flex flex-col gap-3" role="list">
                            {% for item in footer_column_2 %}
                                <li>
                                    <a href="{{ sulu_content_path(item.url) }}"
                                       class="footer-link">
                                        {{ item.title }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% elseif footer.legal_links|default %}
                        <ul class="flex flex-col gap-3" role="list">
                            {% for item in footer.legal_links %}
                                {% if item.label|default and item.link|default %}
                                    {% set link_view = legal_links_view[loop.index0].link|default({}) %}
                                    <li>
                                        <a href="{{ item.link }}"
                                           {% if link_view.target|default %}
                                               target="{{ link_view.target }}"
                                           {% endif %}
                                           {% if link_view.rel|default %}
                                               rel="{{ link_view.rel }}"
                                           {% endif %}
                                           class="footer-link">
                                            {{ item.label }}
                                        </a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endif %}

            {% if footer.contact_title|default or (footer.cta_label|default and footer.cta_link|default) %}
                <div class="flex flex-col gap-4">
                    {% if footer.contact_title|default %}
                        <h2 class="type-kicker">
                            {{ footer.contact_title }}
                        </h2>
                    {% endif %}
                    {% if footer.cta_label|default and footer.cta_link|default %}
                        <a href="{{ footer.cta_link }}"
                           {% if cta_link_view.target|default %}
                               target="{{ cta_link_view.target }}"
                           {% endif %}
                           {% if cta_link_view.rel|default %}
                               rel="{{ cta_link_view.rel }}"
                           {% endif %}
                           class="btn-primary self-start">
                            {{ footer.cta_label }}
                        </a>
                    {% endif %}
                </div>
            {% endif %}

        </div>

        <div class="site-footer-bottom flex flex-col gap-2 pt-6
                    sm:flex-row sm:justify-between border-t">
            {% if footer.copyright_text|default %}
                <p class="type-meta">
                    © {{ 'now'|date('Y') }} {{ footer.copyright_text }}
                </p>
            {% endif %}

            <ul class="flex flex-wrap gap-x-5 gap-y-2" role="list">
                <li>
                    <a href="/privacybeleid"
                       class="footer-link">
                        Privacybeleid
                    </a>
                </li>
                {% if footer_legal %}
                    {% for item in footer_legal %}
                        <li>
                            <a href="{{ sulu_content_path(item.url) }}"
                               class="footer-link">
                                {{ item.title }}
                            </a>
                        </li>
                    {% endfor %}
                {% endif %}
            </ul>

            <span class="footer-mark type-meta" aria-hidden="true">
                ✦
            </span>
        </div>

    </div>

</footer>
