<nav class="relative z-10 flex justify-between items-center
            px-5 py-4
            md:px-10
            lg:px-[44px]
            bg-navy-deepest/65 backdrop-blur-md
            border-b"
     style="border-color: var(--color-gold-15);"
     aria-label="Hoofdnavigatie">

    {# Logo #}
    <a href="{{ sulu_content_root_path() }}"
       class="flex items-center shrink-0"
       aria-label="JouwReiswijzer – naar homepage">

        {# Desktop: volledig logo #}
        <img src="{{ asset('images/logo.svg') }}"
             alt="JouwReiswijzer"
             width="160"
             height="85"
             class="hidden sm:block h-[48px] w-auto">

        {# Mobiel: alleen beeldmerk #}
        <img src="{{ asset('images/logo-mark.svg') }}"
             alt="JouwReiswijzer"
             width="50"
             height="53"
             class="sm:hidden h-[40px] w-auto">

    </a>

    {# Desktop navigatie #}
    <ul class="hidden md:flex items-center gap-6 lg:gap-7"
        role="list">
        {% for item in sulu_page_navigation_root_tree('main', 1, {
            title: 'title',
            url: 'url',
        }) %}
            <li>
                <a href="{{ sulu_content_path(item.url) }}"
                   class="font-body font-light text-[11px] tracking-[0.15em]
                          uppercase text-content-dim
                          transition-colors hover:text-gold
                          {{ item.url == app.request.pathInfo ? 'text-gold' : '' }}">
                    {{ item.title }}
                </a>
            </li>
        {% endfor %}
    </ul>

    {# CTA knop #}
    <div class="flex items-center gap-4">
        <a href="/aanvragen"
           class="hidden sm:inline-flex items-center
                  font-body font-light text-[10px] tracking-[0.2em] uppercase
                  text-gold border px-5 py-2.5
                  transition-colors hover:bg-gold hover:text-navy-deepest"
           style="border-color: var(--color-gold-30);">
            Reis aanvragen
        </a>

        {# Hamburger mobiel #}
        <button type="button"
                class="md:hidden flex flex-col gap-1.5 p-2"
                aria-expanded="false"
                aria-controls="mobile-menu"
                aria-label="Menu openen"
                data-controller="nav-toggle"
                data-action="click->nav-toggle#toggle">
            <span class="block w-6 h-px bg-content-secondary transition-all"></span>
            <span class="block w-6 h-px bg-content-secondary transition-all"></span>
            <span class="block w-4 h-px bg-content-secondary transition-all"></span>
        </button>
    </div>

    {# Mobiel menu #}
    <div id="mobile-menu"
         class="absolute top-full left-0 right-0 hidden
                bg-navy-deepest/95 backdrop-blur-md
                border-b"
         style="border-color: var(--color-gold-15);"
         aria-hidden="true">
        <ul class="flex flex-col px-5 py-6 gap-5" role="list">
            {% for item in sulu_page_navigation_root_tree('main', 1, {
                title: 'title',
                url: 'url',
            }) %}
                <li>
                    <a href="{{ sulu_content_path(item.url) }}"
                       class="font-body font-light text-[12px] tracking-[0.15em]
                              uppercase text-content-secondary
                              hover:text-gold transition-colors">
                        {{ item.title }}
                    </a>
                </li>
            {% endfor %}
            <li class="pt-2 border-t" style="border-color: var(--color-gold-10);">
                <a href="/aanvragen"
                   class="inline-flex items-center
                          font-body font-light text-[10px] tracking-[0.2em] uppercase
                          text-gold">
                    Reis aanvragen →
                </a>
            </li>
        </ul>
    </div>

</nav>
