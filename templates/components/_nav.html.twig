{% set root_path = sulu_content_root_path() %}
{% set main_navigation = sulu_page_navigation_root_tree('main', 1, {
    title: 'title',
    url: 'url',
})|default([]) %}

<nav class="site-nav relative z-10 flex justify-between items-center
            px-5 py-4
            md:px-10
            lg:px-[44px]
            border-b"
     aria-label="Hoofdnavigatie">

    {# Logo #}
    <a href="{{ root_path }}"
       class="flex items-center shrink-0"
       aria-label="Jouw ReisWijzer – naar homepage">

        {# Desktop: volledig logo #}
        <img src="{{ asset('images/logo.svg') }}"
             alt="Jouw ReisWijzer"
             width="160"
             height="85"
             loading="lazy"
             class="site-logo-full hidden w-auto sm:block">

        {# Mobiel: alleen beeldmerk #}
        <img src="{{ asset('images/logo-mark.svg') }}"
             alt="Jouw ReisWijzer"
             width="50"
             height="53"
             loading="lazy"
             class="site-logo-mark w-auto sm:hidden">

    </a>

    {# Desktop navigatie #}
    <ul class="hidden md:flex items-center gap-6 lg:gap-7"
        role="list">
        <li>
            <a href="{{ root_path }}"
               class="nav-link {{ app.request.pathInfo == root_path ? 'is-active' : '' }}">
                Home
            </a>
        </li>
        {% for item in main_navigation %}
            <li>
                <a href="{{ sulu_content_path(item.url) }}"
                   class="nav-link {{ item.url == app.request.pathInfo ? 'is-active' : '' }}">
                    {{ item.title }}
                </a>
            </li>
        {% endfor %}
    </ul>

    {# Acties #}
    <div class="flex items-center gap-4">
        <a href="/aanvragen"
           class="nav-request-link hidden sm:inline-flex items-center gap-2.5
                  type-tag px-5 py-2.5">
            Reis aanvragen
        </a>

        {% if is_granted('ROLE_SULU_CUSTOMER') %}
            {% set unread_notifications = account_unread_notification_count() %}
            {% set has_active_travel_plan = account_has_active_travel_plan() %}
            {% set account_route = app.request.attributes.get('_route') %}
            <details class="nav-account-menu hidden md:block">
                <summary class="nav-account-summary">
                    <svg class="nav-account-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M4.5 20c.8-4 3.3-6 7.5-6s6.7 2 7.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    <span class="nav-account-status-dot" aria-hidden="true"></span>
                    {{ app.user.fullName|default('Mijn Omgeving') }}
                    <svg class="nav-account-chevron" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                        <path d="m1 1 5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </summary>
                <div class="nav-account-dropdown">
                    <div class="nav-account-dropdown-header">
                        <span>Ingelogd als</span>
                        <strong>{{ app.user.fullName|default(app.user.userIdentifier) }}</strong>
                    </div>
                    <a href="{{ path('account') }}">Mijn reisplannen</a>
                    <a
                        href="{{ path('account') }}"
                        class="nav-account-dropdown-row {{ account_route == 'account' or has_active_travel_plan ? 'is-active' : '' }}"
                    >
                        <span>Reishulp</span>
                        {% if has_active_travel_plan %}
                            <span class="nav-account-badge">Nu</span>
                        {% endif %}
                    </a>
                    <a href="{{ path('account_notifications') }}" class="nav-account-dropdown-row">
                        <span>Notificaties</span>
                        {% if unread_notifications > 0 %}
                            <span class="nav-account-badge">{{ unread_notifications }}</span>
                        {% endif %}
                    </a>
                    <a href="{{ path('account_profile') }}">Profiel</a>
                    <a href="{{ path('account_password') }}">Wachtwoord wijzigen</a>
                    <form method="post" action="{{ path('account_logout') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit">Uitloggen</button>
                    </form>
                </div>
            </details>
        {% else %}
            <a
                href="{{ path('account_login') }}"
                class="nav-account-link hidden md:inline-flex {{ app.request.attributes.get('_route') == 'account_login' ? 'is-active' : '' }}"
            >
                <svg class="nav-account-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M4.5 20c.8-4 3.3-6 7.5-6s6.7 2 7.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                Mijn Omgeving
            </a>
        {% endif %}

        {# Hamburger mobiel #}
        <button type="button"
                class="md:hidden flex flex-col gap-1.5 p-2"
                aria-expanded="false"
                aria-controls="mobile-menu"
                aria-label="Menu openen"
                data-controller="nav-toggle"
                data-action="click->nav-toggle#toggle">
            <span class="nav-toggle-line block w-6" aria-hidden="true"></span>
            <span class="nav-toggle-line block w-6" aria-hidden="true"></span>
            <span class="nav-toggle-line block w-4" aria-hidden="true"></span>
        </button>
    </div>

    {# Mobiel menu #}
    <div id="mobile-menu"
         class="mobile-menu absolute top-full left-0 right-0 hidden
                border-b"
        aria-hidden="true">
        <ul class="flex flex-col px-5 py-6 gap-5" role="list">
            <li>
                <a href="{{ root_path }}"
                   class="nav-link {{ app.request.pathInfo == root_path ? 'is-active' : '' }}">
                    Home
                </a>
            </li>
            {% for item in main_navigation %}
                <li>
                    <a href="{{ sulu_content_path(item.url) }}"
                       class="nav-link">
                        {{ item.title }}
                    </a>
                </li>
            {% endfor %}
            <li class="mobile-menu-request pt-2 border-t">
                <a href="/aanvragen"
                   class="btn-ghost">
                    Reis aanvragen →
                </a>
            </li>
            <li class="mobile-account-links pt-2 border-t">
                {% if is_granted('ROLE_SULU_CUSTOMER') %}
                    <a href="{{ path('account') }}" class="nav-link block">
                        Mijn reisplannen
                    </a>
                    <a href="{{ path('account') }}" class="nav-link mt-4 flex items-center gap-2 {{ account_route == 'account' or has_active_travel_plan ? 'is-active' : '' }}">
                        Reishulp
                        {% if has_active_travel_plan %}
                            <span class="nav-account-badge">Nu</span>
                        {% endif %}
                    </a>
                    <a href="{{ path('account_notifications') }}" class="nav-link mt-4 flex items-center gap-2">
                        Notificaties
                        {% if unread_notifications > 0 %}
                            <span class="nav-account-badge">{{ unread_notifications }}</span>
                        {% endif %}
                    </a>
                    <a href="{{ path('account_profile') }}" class="nav-link mt-4 block">
                        Mijn profiel
                    </a>
                    <a href="{{ path('account_password') }}" class="nav-link mt-4 block">
                        Wachtwoord wijzigen
                    </a>
                    <form method="post" action="{{ path('account_logout') }}" class="mt-4">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="nav-link">Uitloggen</button>
                    </form>
                {% else %}
                    <a href="{{ path('account_login') }}" class="nav-link block">
                        Mijn Omgeving
                    </a>
                {% endif %}
            </li>
        </ul>
    </div>

</nav>
