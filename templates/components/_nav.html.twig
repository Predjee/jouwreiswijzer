{% set root_path = sulu_content_root_path() %}

<nav class="site-nav relative z-10 flex justify-between items-center
            px-5 py-4
            md:px-10
            lg:px-[44px]
            border-b"
     aria-label="Hoofdnavigatie">

    {# Logo #}
    <a href="{{ root_path }}"
       class="flex items-center shrink-0"
       aria-label="JouwReiswijzer – naar homepage">

        {# Desktop: volledig logo #}
        <img src="{{ asset('images/logo.svg') }}"
             alt="JouwReiswijzer"
             width="160"
             height="85"
             loading="lazy"
             class="site-logo-full hidden w-auto sm:block">

        {# Mobiel: alleen beeldmerk #}
        <img src="{{ asset('images/logo-mark.svg') }}"
             alt="JouwReiswijzer"
             width="50"
             height="53"
             loading="lazy"
             class="site-logo-mark w-auto sm:hidden">

    </a>

    {# Desktop navigatie #}
    <ul class="hidden md:flex items-center gap-6 lg:gap-7"
        role="list">
        <li>
            <a href="{{ root_path }}"
               class="nav-link {{ app.request.pathInfo == root_path ? 'is-active' : '' }}">
                Home
            </a>
        </li>
        {% for item in sulu_page_navigation_root_tree('main', 1, {
            title: 'title',
            url: 'url',
        }) %}
            <li>
                <a href="{{ sulu_content_path(item.url) }}"
                   class="nav-link {{ item.url == app.request.pathInfo ? 'is-active' : '' }}">
                    {{ item.title }}
                </a>
            </li>
        {% endfor %}
    </ul>

    {# CTA knop #}
    <div class="flex items-center gap-4">
        <a href="/aanvragen"
           class="nav-request-link hidden sm:inline-flex items-center gap-2.5
                  type-tag px-5 py-2.5">
            Reis aanvragen
        </a>

        {# Hamburger mobiel #}
        <button type="button"
                class="md:hidden flex flex-col gap-1.5 p-2"
                aria-expanded="false"
                aria-controls="mobile-menu"
                aria-label="Menu openen"
                data-controller="nav-toggle"
                data-action="click->nav-toggle#toggle">
            <span class="nav-toggle-line block w-6" aria-hidden="true"></span>
            <span class="nav-toggle-line block w-6" aria-hidden="true"></span>
            <span class="nav-toggle-line block w-4" aria-hidden="true"></span>
        </button>
    </div>

    {# Mobiel menu #}
    <div id="mobile-menu"
         class="mobile-menu absolute top-full left-0 right-0 hidden
                border-b"
        aria-hidden="true">
        <ul class="flex flex-col px-5 py-6 gap-5" role="list">
            <li>
                <a href="{{ root_path }}"
                   class="nav-link {{ app.request.pathInfo == root_path ? 'is-active' : '' }}">
                    Home
                </a>
            </li>
            {% for item in sulu_page_navigation_root_tree('main', 1, {
                title: 'title',
                url: 'url',
            }) %}
                <li>
                    <a href="{{ sulu_content_path(item.url) }}"
                       class="nav-link">
                        {{ item.title }}
                    </a>
                </li>
            {% endfor %}
            <li class="mobile-menu-request pt-2 border-t">
                <a href="/aanvragen"
                   class="btn-ghost">
                    Reis aanvragen →
                </a>
            </li>
        </ul>
    </div>

</nav>
