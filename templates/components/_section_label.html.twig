{% if label is defined and label %}
    <p class="flex items-center gap-2.5
              font-body font-light text-[10px] tracking-[0.28em] uppercase
              text-gold mb-3">
        <span class="block w-[18px] h-px bg-gold shrink-0" aria-hidden="true"></span>
        {{ label }}
    </p>
{% endif %}
