            <circle cx="0" cy="0" r="1.2" fill="var(--color-gold)"/>
        </g>
    </g>

    <g style="animation: jrwTwinkle3 2.7s ease-in-out infinite">
        <g transform="translate(192,47)">
            <line x1="0"    y1="-6.5" x2="0"   y2="6.5"
                  stroke="var(--color-gold)" stroke-width="0.65"/>
            <line x1="-6.5" y1="0"    x2="6.5" y2="0"
                  stroke="var(--color-gold)" stroke-width="0.65"/>
            <line x1="-4"   y1="-4"   x2="4"   y2="4"
                  stroke="var(--color-gold)" stroke-width="0.35" opacity="0.4"/>
            <line x1="4"    y1="-4"   x2="-4"  y2="4"
                  stroke="var(--color-gold)" stroke-width="0.35" opacity="0.4"/>
            <circle cx="0" cy="0" r="0.9" fill="var(--color-gold)"/>
        </g>
    </g>

    <g style="animation: jrwTwinkle 3.9s 1.2s ease-in-out infinite">
        <g transform="translate(730,61)">
            <line x1="0"  y1="-5" x2="0" y2="5"
                  stroke="var(--color-content-primary)" stroke-width="0.6"/>
            <line x1="-5" y1="0"  x2="5" y2="0"
                  stroke="var(--color-content-primary)" stroke-width="0.6"/>
            <circle cx="0" cy="0" r="0.8" fill="var(--color-content-primary)"/>
        </g>
    </g>

    <g style="animation: jrwTwinkle2 2.1s ease-in-out infinite">
        <g transform="translate(876,51)">
            <line x1="0"    y1="-4.5" x2="0"   y2="4.5"
                  stroke="var(--color-gold)" stroke-width="0.55"/>
            <line x1="-4.5" y1="0"    x2="4.5" y2="0"
                  stroke="var(--color-gold)" stroke-width="0.55"/>
            <circle cx="0" cy="0" r="0.75" fill="var(--color-gold)"/>
        </g>
    </g>

</svg>
