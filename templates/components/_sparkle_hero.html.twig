<svg class="absolute inset-0 w-full h-full pointer-events-none"
     viewBox="0 0 1100 620"
     preserveAspectRatio="xMidYMid slice"
     xmlns="http://www.w3.org/2000/svg"
     aria-hidden="true">
    <defs>
        <radialGradient id="moonGrad" cx="38%" cy="36%" r="55%">
            <stop offset="0%"   stop-color="var(--color-content-primary)"/>
            <stop offset="45%"  stop-color="var(--color-gold)"/>
            <stop offset="100%" stop-color="var(--color-gold)" stop-opacity="0.55"/>
        </radialGradient>
        <radialGradient id="moonHalo" cx="50%" cy="50%" r="50%">
            <stop offset="0%"   stop-color="var(--color-gold)" stop-opacity="0.2"/>
            <stop offset="100%" stop-color="var(--color-gold)" stop-opacity="0"/>
        </radialGradient>
        <filter id="blur8"><feGaussianBlur stdDeviation="8"/></filter>
        <filter id="blur2"><feGaussianBlur stdDeviation="2"/></filter>
    </defs>

    <circle cx="88"  cy="42" r="0.8" fill="var(--color-content-primary)" opacity="0.55"/>
    <circle cx="172" cy="26" r="0.6" fill="var(--color-content-primary)" opacity="0.40"/>
    <circle cx="248" cy="58" r="0.9" fill="var(--color-content-primary)" opacity="0.48"/>
    <circle cx="325" cy="19" r="0.7" fill="var(--color-content-primary)" opacity="0.36"/>
    <circle cx="408" cy="48" r="0.8" fill="var(--color-content-primary)" opacity="0.42"/>
    <circle cx="556" cy="16" r="0.9" fill="var(--color-content-primary)" opacity="0.46"/>
    <circle cx="712" cy="28" r="0.8" fill="var(--color-content-primary)" opacity="0.42"/>
    <circle cx="858" cy="20" r="0.9" fill="var(--color-content-primary)" opacity="0.48"/>
    <circle cx="935" cy="46" r="0.7" fill="var(--color-content-primary)" opacity="0.36"/>
    <circle cx="1008" cy="33" r="0.8" fill="var(--color-content-primary)" opacity="0.40"/>
    <circle cx="52"  cy="78" r="0.7" fill="var(--color-content-primary)" opacity="0.26"/>
    <circle cx="444" cy="72" r="0.6" fill="var(--color-content-primary)" opacity="0.24"/>

    <circle cx="918" cy="108" r="88" fill="url(#moonHalo)" filter="url(#blur8)"/>
    <circle cx="918" cy="108" r="36" fill="url(#moonGrad)"/>
    <circle cx="918" cy="108" r="48"
            fill="none" stroke="var(--color-gold)" stroke-width="0.35" opacity="0.2"/>
    <circle cx="918" cy="108" r="65"
            fill="none" stroke="var(--color-gold)" stroke-width="0.2"  opacity="0.1"/>

    <circle cx="572" cy="355" r="1.2" fill="var(--color-gold)" opacity="0.30" filter="url(#blur2)"/>
    <circle cx="610" cy="352" r="1.0" fill="var(--color-gold)" opacity="0.26" filter="url(#blur2)"/>
    <circle cx="652" cy="353" r="1.1" fill="var(--color-gold)" opacity="0.22" filter="url(#blur2)"/>
    <circle cx="694" cy="352" r="1.0" fill="var(--color-gold)" opacity="0.24" filter="url(#blur2)"/>

    <rect x="0" y="360" width="1100" height="1"
          fill="var(--color-gold-08)"/>

    <g style="animation: jrwTwinkle 4.5s ease-in-out infinite">
        <g transform="translate(966,74)">
            <g style="animation: jrwRotate 22s linear infinite; transform-origin: 0px 0px">
                <line x1="0"  y1="-13" x2="0"  y2="13"
                      stroke="var(--color-gold)" stroke-width="1"/>
                <line x1="-13" y1="0"  x2="13" y2="0"
                      stroke="var(--color-gold)" stroke-width="1"/>
                <line x1="-9" y1="-9"  x2="9"  y2="9"
                      stroke="var(--color-gold)" stroke-width="0.55" opacity="0.5"/>
                <line x1="9"  y1="-9"  x2="-9" y2="9"
                      stroke="var(--color-gold)" stroke-width="0.55" opacity="0.5"/>
            </g>
            <circle cx="0" cy="0" r="1.8" fill="var(--color-gold)"/>
        </g>
    </g>

    <g style="animation: jrwTwinkle2 3.2s ease-in-out infinite">
        <g transform="translate(502,34)">
            <line x1="0"  y1="-9" x2="0" y2="9"
                  stroke="var(--color-gold)" stroke-width="0.75"/>
            <line x1="-9" y1="0"  x2="9" y2="0"
                  stroke="var(--color-gold)" stroke-width="0.75"/>
            <line x1="-6" y1="-6" x2="6" y2="6"
                  stroke="var(--color-gold)" stroke-width="0.4" opacity="0.45"/>
            <line x1="6"  y1="-6" x2="-6" y2="6"
