{% extends 'emails/base.html.twig' %}

{% block subject %}Welkom bij Jouw ReisWijzer{% endblock %}

{% block content %}
    <p style="margin:0 0 10px;color:#9b7a19;font-size:12px;font-weight:bold;letter-spacing:1.5px;text-transform:uppercase;">
        Mijn omgeving
    </p>

    <h1 style="margin:0 0 20px;color:#0f293a;font-family:Georgia,'Times New Roman',serif;font-size:34px;font-weight:normal;line-height:1.2;">
        Welkom {{ contact.firstName|default('')|striptags }}
    </h1>

    <p style="margin:0 0 28px;color:#4d5d68;font-size:16px;line-height:1.7;">
        Er is een account voor je aangemaakt. Stel binnen 48 uur je wachtwoord in om toegang te krijgen tot je persoonlijke reisomgeving.
    </p>

    <p style="margin:0 0 28px;">
        <a
            href="{{ reset_url }}"
            style="display:inline-block;padding:14px 24px;border-radius:3px;background-color:#d4af37;color:#0f293a;font-size:15px;font-weight:bold;text-decoration:none;"
        >
            Wachtwoord instellen
        </a>
    </p>

    <p style="margin:0;color:#4d5d68;font-size:14px;line-height:1.7;">
        Werkt de knop niet? Open dan deze link:<br>
        <a href="{{ reset_url }}" style="color:#735b15;word-break:break-all;">{{ reset_url }}</a>
    </p>
{% endblock %}

{% block footer_text %}
    Deze link is 48 uur geldig en kan één keer worden gebruikt.
{% endblock %}
