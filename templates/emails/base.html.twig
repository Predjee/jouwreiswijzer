<!doctype html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block subject %}JouwReisWijzer{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background-color:#0f293a;color:#243a4e;font-family:Arial,Helvetica,sans-serif;">
{% set logoUrl = absolute_url(asset('email/logo-email.png')) %}

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;background-color:#0f293a;">
    <tr>
        <td align="center" style="padding:40px 16px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;max-width:{% block max_width %}680px{% endblock %};">
                <tr>
                    <td align="center" style="padding:0 8px 24px;">
                        <img
                            src="{{ logoUrl }}"
                            alt="JouwReisWijzer"
                            width="220"
                            style="display:block;width:220px;max-width:220px;height:auto;border:0;outline:none;text-decoration:none;"
                        >
                    </td>
                </tr>

                <tr>
                    <td style="overflow:hidden;border-radius:12px;background-color:#f7f4ee;box-shadow:0 12px 30px rgba(0,0,0,.18);">
                        <div style="height:5px;background-color:#d4af37;font-size:0;line-height:0;">&nbsp;</div>
                        <div style="padding:40px 40px 36px;">
                            {% block content %}{% endblock %}
                        </div>
                    </td>
                </tr>

                {% block footer %}
                    <tr>
                        <td align="center" style="padding:20px 16px 0;color:#aab5bc;font-size:12px;line-height:1.6;">
                            {% block footer_text %}Dit is een automatische e-mail van JouwReisWijzer.{% endblock %}
                        </td>
                    </tr>
                {% endblock %}
            </table>
        </td>
    </tr>
</table>
</body>
</html>
