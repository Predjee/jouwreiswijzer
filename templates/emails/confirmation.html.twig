{% extends 'emails/base.html.twig' %}

{% block subject %}Bedankt voor je inzending{% endblock %}

{% block content %}
    <p style="margin:0 0 10px;color:#9b7a19;font-size:12px;font-weight:bold;letter-spacing:1.5px;text-transform:uppercase;">
        {{ formEntity.title|default('Formulier')|striptags }}
    </p>

    <h1 style="margin:0 0 20px;color:#0f293a;font-family:Georgia,'Times New Roman',serif;font-size:34px;font-weight:normal;line-height:1.2;">
        Bedankt voor je inzending
    </h1>

    {% if formEntity.mailText|default('') %}
        <p style="margin:0 0 28px;color:#4d5d68;font-size:16px;line-height:1.7;">
            {{ form_mail_placeholders(
                formEntity.mailText,
                formEntity.fields|default([])
            )|striptags }}
        </p>
    {% endif %}

    {{ include('emails/_form_fields.html.twig') }}

    <p style="margin:28px 0 0;color:#4d5d68;font-size:15px;line-height:1.7;">
        Hartelijke groet,<br>
        <strong style="color:#0f293a;">JouwReisWijzer</strong>
    </p>
{% endblock %}

{% block footer_text %}
    Dit is een automatische bevestiging van je formulierinzending.
{% endblock %}
