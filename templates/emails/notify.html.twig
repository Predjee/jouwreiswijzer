{% extends 'emails/base.html.twig' %}

{% block subject %}Nieuwe formulierinzending ontvangen{% endblock %}
{% block max_width %}720px{% endblock %}

{% block content %}
    <p style="margin:0 0 8px;color:#9b7a19;font-size:12px;font-weight:bold;letter-spacing:1.4px;text-transform:uppercase;">
        Nieuwe inzending
    </p>

    <h1 style="margin:0 0 12px;color:#0f293a;font-family:Georgia,'Times New Roman',serif;font-size:30px;font-weight:normal;line-height:1.25;">
        Nieuwe formulierinzending ontvangen
    </h1>

    <p style="margin:0 0 26px;color:#4d5d68;font-size:15px;line-height:1.6;">
        Formulier: <strong style="color:#0f293a;">{{ formEntity.title|default('Onbekend formulier')|striptags }}</strong>
    </p>

    {{ include('emails/_form_fields.html.twig') }}

    <p style="margin:24px 0 0;color:#71808a;font-size:13px;line-height:1.6;">
        Deze melding is automatisch verstuurd na een nieuwe inzending via de formulieren module.
    </p>
{% endblock %}
