{% extends 'base.html.twig' %}

{% block content %}
    <section class="section">
        <div class="aanvraag-layout">
            <div class="aanvraag-intro">
                <h1 class="type-hero-title">{{ content.title }}</h1>
                {% if content.intro %}
                    <div class="type-body">{{ content.intro|raw }}</div>
                {% endif %}
            </div>

            <div class="aanvraag-form">
                {% if content.form %}
                    {% if app.request.get('send') != 'true' %}
                        {% set form_type = content.form.vars is defined ? content.form.children.type.vars.value|default('pages') : 'pages' %}
                        {% set form_view = content.form.vars is defined ? content.form : sulu_form_get_by_id(content.form, form_type, resource.id) %}
                        {% form_theme form_view 'form/theme.html.twig' %}
                        {{ form(form_view) }}
                    {% else %}
                        <div class="aanvraag-success">
                            <div class="type-body">
                                {{ view.form.entity.successText|default('')|raw }}
                            </div>
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </section>

    <div class="page-blocks">
        {% for block in content.blocks|default([]) %}
            {{ include(
                'blocks/_' ~ block.type ~ '.html.twig',
                {block: block},
                with_context: true,
                ignore_missing: true,
            ) }}
        {% endfor %}
    </div>
{% endblock %}
