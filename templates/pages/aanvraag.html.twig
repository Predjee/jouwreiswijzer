{% extends 'base.html.twig' %}

{% block content %}
    <section class="section">
        <div class="aanvraag-layout">
            <div class="aanvraag-intro">
                <h1 class="type-hero-title">{{ content.title }}</h1>
                {% if content.intro %}
                    <div class="type-body">{{ content.intro|raw }}</div>
                {% endif %}
            </div>

            <div class="aanvraag-form">
                {% if content.form %}
                    {% if app.request.get('send') != 'true' %}
                        {% set form_view = sulu_form_build(content.form, 'page', resource.id) %}
                        {% form_theme form_view 'form/theme.html.twig' %}
                        {{ form(form_view) }}
                    {% else %}
                        <div class="aanvraag-success">
                            <p class="type-section-title">Bedankt voor je aanvraag!</p>
                            <p class="type-body">Wij nemen binnen twee werkdagen contact met je op.</p>
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
