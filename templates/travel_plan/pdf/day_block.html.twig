{# Dagkaart in de PDF.
   mPDF is gevoelig voor CSS-cascade in tabellen; daarom staan de kritieke
   kleuren inline en blijft de stylesheet vooral typografie/spacing doen. #}
{% set variant = block.isPrimary ? 'primary' : (block.isSecondary ? 'secondary' : (block.isGold ? 'gold' : 'default')) %}
{% set v = t.variants[variant] %}
{% set colorClass = variant != 'default' ? ' travel-plan-block--' ~ variant : '' %}
{# Luxe = terughoudendheid: standaardkaarten dragen alleen een hairline
   omranding; uitsluitend kaarten met een CMS-kleurkeuze krijgen één
   accent (linkerbalk). Alle overige kleuren komen uit hetzelfde palet
   (t.variants), zodat tekst, meta en links automatisch meekleuren. #}
{% set accentBorder = v.accent ? ' border-left: 0.8mm solid ' ~ v.accent ~ ';' : '' %}
{% set cardStyle = 'background-color: ' ~ v.background ~ '; border: 0.2mm solid ' ~ v.edge ~ ';' ~ accentBorder ~ ' border-radius: ' ~ t.cardRadius ~ '; overflow: hidden;' %}
{% set flowStyle = 'background-color: ' ~ v.background ~ '; border: 0.2mm solid ' ~ v.edge ~ ';' ~ accentBorder ~ ' border-bottom: 0; border-radius: ' ~ t.cardRadius ~ ' ' ~ t.cardRadius ~ ' 0 0; overflow: visible;' %}

{% if block.flow %}
<div class="travel-plan-block travel-plan-block--flow travel-plan-block--{{ block.type }}{{ colorClass }}{% if block.startOnNewPage %} travel-plan-page-break-before{% endif %}" style="{{ flowStyle }}">
    <div class="travel-plan-block__main travel-plan-block__main--flow" style="border-radius: {{ t.cardRadius }} {{ t.cardRadius }} 0 0;">
        <div class="travel-plan-block__header">
            {% if block.iconSrc %}<img class="travel-plan-icon" src="{{ block.iconSrc }}" alt="">{% endif %}
            {{ _self.header(block, v) }}
        </div>
        {{ _self.content(block, v) }}
    </div>
</div>
{% else %}
<div class="travel-plan-block travel-plan-block--{{ block.type }}{{ colorClass }}{% if block.startOnNewPage %} travel-plan-page-break-before{% endif %}" style="{{ cardStyle }}">
    <table class="travel-plan-block__layout" style="width: 100%; background-color: {{ v.background }}; border: 0; border-collapse: separate; border-spacing: 0;">
        <tr>
            <td class="travel-plan-block__icon-cell" style="width: 12.5mm; padding: 4.6mm 3mm 4.2mm 4.6mm; vertical-align: top; background-color: {{ v.background }};">
            {% if block.iconSrc %}
                <img class="travel-plan-icon" src="{{ block.iconSrc }}" style="float: none; display: block; width: 6.5mm; height: 6.5mm; margin: 0.4mm 0 0;" alt="">
            {% endif %}
            </td>
            <td class="travel-plan-block__body-cell" style="padding: 4.6mm 5.5mm 4.2mm 0; vertical-align: top; background-color: {{ v.background }};">
                <div class="travel-plan-block__main">
                    <div class="travel-plan-block__header">{{ _self.header(block, v) }}</div>
                    {{ _self.content(block, v) }}
                </div>
            </td>
        </tr>
    </table>
</div>
{% endif %}

{% macro header(block, v) %}
    {% if block.timeRangeLabel|default or block.timeLabel|default %}
        <p class="travel-plan-block__time" style="color: {{ v.meta }};">{% if block.timeRangeLabel|default %}<strong>{{ block.timeRangeLabel }}</strong>{% endif %}{% if block.timeRangeLabel|default and block.timeLabel|default %} - {% endif %}{{ block.timeLabel|default('') }}</p>
    {% endif %}
    {% if block.title|default %}<h3 style="color: {{ v.title }};">{{ block.title }}</h3>{% endif %}
    {% if block.location|default %}<p class="travel-plan-block__location" style="color: {{ v.meta }};">{{ block.location }}</p>{% endif %}
{% endmacro %}

{% macro content(block, v) %}
    {% if block.textHtml|default %}
        {% set textHtml = block.textHtml|replace({
            '#e7e0d3': v.body,
            '#d8dde2': v.body,
            '#eef1f6': v.body,
            '#f7f4ee': v.body
        }) %}
        <div class="travel-plan-section__content travel-plan-block__content" style="color: {{ v.body }};">{{ textHtml|raw }}</div>
    {% endif %}
    {% if block.bookingUrl|default %}
        <p class="travel-plan-block__action"><a href="{{ block.bookingUrl }}" style="color: {{ v.link }};">{{ block.actionLabel }}</a></p>
    {% endif %}
{% endmacro %}
