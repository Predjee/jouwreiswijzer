{# Volledig PDF-document. NB: TravelPlanPdfGenerator splitst deze output in
   chunks op <pagebreak>/<tocpagebreak>/<tocentry> en <!--PDF-CHUNK-->;
   elke sectie moet als eigen chunk naar mPDF (grote chunks corrumperen
   mPDF's schilderstatus — verbleekte achtergronden). #}
<htmlpagefooter name="travelPlanFooter">
    <div class="travel-plan-footer">
        JouwReisWijzer &nbsp;&middot;&nbsp; {{ travelPlan.title }} &nbsp;&middot;&nbsp; pagina {PAGENO}
    </div>
</htmlpagefooter>

<div class="travel-plan">
    <div class="travel-plan-cover">
        {% if logoSrc %}
            <img class="travel-plan-cover__logo" src="{{ logoSrc }}" alt="JouwReisWijzer">
        {% endif %}
        <p class="travel-plan-cover__eyebrow">Persoonlijke reisgids</p>
        <h1>{{ travelPlan.title }}</h1>
        {% if intro.title|default and intro.title != travelPlan.title %}
            <p class="travel-plan-cover__subtitle">{{ intro.title }}</p>
        {% endif %}
        {% if customerName %}
            <p class="travel-plan-cover__customer">Samengesteld voor {{ customerName }}</p>
        {% endif %}
        <div class="travel-plan-cover__rule">&nbsp;</div>
        {% set coverProfile = [tripProfile.period|default, tripProfile.duration|default]|filter(value => value) %}
        {% if coverProfile %}
            <p class="travel-plan-cover__profile">{{ coverProfile|join(' · ') }}</p>
        {% endif %}
    </div>

    <pagebreak margin-left="18mm"
               margin-right="18mm"
               margin-top="20mm"
               margin-bottom="23mm"
               resetpagenum="1"
               suppress="off"
               odd-footer-name="travelPlanFooter"
               odd-footer-value="on"
               even-footer-name="travelPlanFooter"
               even-footer-value="on" />

    <div class="travel-plan__header">
        {% if intro.title|default %}
            {# Inline: mPDF's child-selector (.travel-plan__header > h2) is
               onbetrouwbaar, waardoor de kop anders in sans-bold terugvalt. #}
            <h2 style="margin: 0 0 6mm; padding: 0 0 2.4mm; border: 0; border-bottom: 0.45mm solid {{ theme.gold }}; color: {{ theme.navy }}; font-family: 'Cormorant', serif; font-weight: normal; font-size: 26pt; line-height: 1.08;">{{ intro.title }}</h2>
        {% endif %}

        {% if intro.text|default %}
            <div class="travel-plan__intro">{{ intro.text|raw }}</div>
        {% endif %}

        {% if tripProfile|default %}
            <table class="travel-plan__profile">
                {% for label, value in {
                    'Periode': tripProfile.period|default,
                    'Duur': tripProfile.duration|default,
                    'Reisgezelschap': tripProfile.travelParty|default,
                    'Reisstijl': tripProfile.travelStyle|default,
                    'Pakket': tripProfile.packageType|default
                } %}
                    {% if value %}
                        <tr><th>{{ label }}</th><td>{{ value }}</td></tr>
                    {% endif %}
                {% endfor %}
            </table>
        {% endif %}
    </div>

{% if tableOfContents|length > 0 %}
    <tocpagebreak
        toc-preHTML="&lt;div class=&quot;travel-plan-toc&quot;&gt;&lt;h2&gt;Inhoudsopgave&lt;/h2&gt;"
        toc-postHTML="&lt;/div&gt;"
        links="on"
        paging="on"
        toc-bookmarkText="Inhoudsopgave"
        toc-odd-footer-name="travelPlanFooter"
        toc-odd-footer-value="on"
        toc-even-footer-name="travelPlanFooter"
        toc-even-footer-value="on" />
{% endif %}

{% for section in sections %}
    {# Na de inhoudsopgave begint mPDF al op een verse pagina; een extra
       pagebreak vóór de allereerste sectie zou een lege pagina geven. #}
    {%- if section.startOnNewPage and not (loop.first and tableOfContents|length > 0) %}<pagebreak />{% endif -%}
    {%- if section.tocTitle %}<tocentry content="{{ section.tocTitle|e('html_attr') }}" level="{{ section.tocLevel }}" />{% endif -%}
    {{ section.html|raw }}<!--PDF-CHUNK-->
{% endfor %}
</div>
