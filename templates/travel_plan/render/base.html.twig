{% set request = travelPlan.travelRequest|default(null) %}
{% set contact = request ? request.contact|default(null) : null %}
{% set customerName = contact
    ? [contact.firstName|default, contact.lastName|default]|filter(value => value)|join(' ')
    : ''
%}

{% if accountView %}
    <link rel="stylesheet" href="{{ asset('styles/travel-plan-theme.css') }}" media="screen">
{% endif %}

{% if not accountView %}
    <htmlpagefooter name="travelPlanFooter">
        <div class="travel-plan-footer">
            Jouw ReisWijzer &nbsp;&middot;&nbsp; {{ travelPlan.title }} &nbsp;&middot;&nbsp; pagina {PAGENO}
        </div>
    </htmlpagefooter>
{% endif %}

{% if accountView %}
<article class="travel-plan">
{% else %}
<div class="travel-plan">
{% endif %}
    {% if not accountView %}
        <div class="travel-plan-cover">
            {% if logoSrc %}
                <img class="travel-plan-cover__logo" src="{{ logoSrc }}" alt="Jouw ReisWijzer">
            {% endif %}
            <p class="travel-plan-cover__eyebrow">Persoonlijke reisgids</p>
            <h1>{{ travelPlan.title }}</h1>
            {% if intro.title|default and intro.title != travelPlan.title %}
                <p class="travel-plan-cover__subtitle">{{ intro.title }}</p>
            {% endif %}
            {% if customerName %}
                <p class="travel-plan-cover__customer">Samengesteld voor {{ customerName }}</p>
            {% endif %}
            <div class="travel-plan-cover__rule">&nbsp;</div>
            {% set coverProfile = [tripProfile.period|default, tripProfile.duration|default]|filter(value => value) %}
            {% if coverProfile %}
                <p class="travel-plan-cover__profile">{{ coverProfile|join(' · ') }}</p>
            {% endif %}
        </div>

        <pagebreak margin-left="18mm"
                   margin-right="18mm"
                   margin-top="20mm"
                   margin-bottom="23mm"
                   resetpagenum="1"
                   suppress="off"
                   odd-footer-name="travelPlanFooter"
                   odd-footer-value="on"
                   even-footer-name="travelPlanFooter"
                   even-footer-value="on" />
    {% endif %}

    {% if accountView %}
    <header class="travel-plan__header">
    {% else %}
    <div class="travel-plan__header">
    {% endif %}
        {% if accountView %}
            <p class="travel-plan-cover__eyebrow">Persoonlijke reisgids</p>
            <h1>{{ intro.title|default(travelPlan.title, true) }}</h1>
            {% if customerName %}
                <p class="travel-plan-cover__customer">Samengesteld voor {{ customerName }}</p>
            {% endif %}
        {% elseif intro.title|default %}
            <h2>{{ intro.title }}</h2>
        {% endif %}

        {% if intro.text|default %}
            <div class="travel-plan__intro">{{ intro.text|raw }}</div>
        {% endif %}

        {% if tripProfile|default %}
            <table class="travel-plan__profile">
                {% for label, value in {
                    'Periode': tripProfile.period|default,
                    'Duur': tripProfile.duration|default,
                    'Reisgezelschap': tripProfile.travelParty|default,
                    'Reisstijl': tripProfile.travelStyle|default,
                    'Pakket': tripProfile.packageType|default
                } %}
                    {% if value %}
                        <tr><th>{{ label }}</th><td>{{ value }}</td></tr>
                    {% endif %}
                {% endfor %}
            </table>
        {% endif %}
    {% if accountView %}
    </header>
    {% else %}
    </div>
    {% endif %}

    {% for renderedSection in renderedSections %}
        {{ renderedSection.html|raw }}
        {% if accountView and feedbackEnabled|default(false) %}
            {{ include('account/_travel_plan_feedback_form.html.twig', {
                travelPlan: travelPlan,
                blockPath: renderedSection.blockPath,
                feedback: renderedSection.feedback,
                feedbackLabel: 'Feedback op dit onderdeel',
                feedbackContext: 'section'
            }) }}
        {% endif %}
    {% endfor %}
{% if accountView %}
</article>
{% else %}
</div>
{% endif %}
