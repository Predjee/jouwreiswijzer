{% if accountView %}
<section class="travel-plan-section travel-plan-section--checklist {{ section.variantClass|default('travel-plan-variant--default') }}{{ section.pageBreakClass ? ' ' ~ section.pageBreakClass : '' }}">{% if section.iconSvg %}<span class="travel-plan-icon-slot" aria-hidden="true">{{ section.iconSvg|raw }}</span>{% endif %}{{ "\n" -}}
{% else %}
{% set colorClass = section.isPrimary ? ' travel-plan-section--primary' : (section.isSecondary ? ' travel-plan-section--secondary' : '') %}
{% set colorStyle = section.isPrimary ? 'background-color: #ffffff; border: 0.25mm solid #12213d; color: #17233b;' : (section.isSecondary ? 'background-color: #f8f5ef; border: 0.25mm solid #d4af37; color: #17233b;' : '') %}
<div class="travel-plan-section travel-plan-section--checklist{{ colorClass }}"{% if colorStyle %} style="{{ colorStyle }}"{% endif %}>
{% endif %}
    {% if section.title|default %}<h2>{{ section.title }}</h2>{% endif %}
    {% if section.text|default %}
        <table class="travel-plan-checklist">
            {% for item in section.text|split("\n")|filter(item => item|trim) %}
                <tr>
                    <td class="travel-plan-checklist__box-cell">
                        <span class="travel-plan-checklist__box">&nbsp;&nbsp;&nbsp;&nbsp;</span>
                    </td>
                    <td class="travel-plan-checklist__text">{{ item|trim }}</td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}
{% if accountView %}
</section>
{% else %}
</div>
{% endif %}
