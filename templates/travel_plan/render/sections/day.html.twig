{% if accountView %}
<section class="travel-plan-section travel-plan-section--day {{ section.variantClass|default('travel-plan-variant--default') }}{{ section.pageBreakClass ? ' ' ~ section.pageBreakClass : '' }}">{% if section.iconSvg %}<span class="travel-plan-icon-slot" aria-hidden="true">{{ section.iconSvg|raw }}</span>{% endif %}{{ "\n" -}}
{% else %}
<div class="travel-plan-section travel-plan-section--day">
{% endif %}
    {# Inline styling in PDF-modus: mPDF's klasse-cascade is onbetrouwbaar
       in gesplitste chunks; inline styles winnen altijd. #}
    <div class="travel-plan-day__header"{% if not accountView %} style="background-color: #12213d; color: #f7f4ee;"{% endif %}>
        {% set dayMeta = [] %}
        {% if section.dayNumber|default('') is not empty %}
            {% set dayMeta = dayMeta|merge(['Dag ' ~ section.dayNumber]) %}
        {% endif %}
        {% if section.dateLabel|default('') is not empty %}
            {% set dayMeta = dayMeta|merge([section.dateLabel]) %}
        {% endif %}
                {% if dayMeta is not empty %}
            <p class="travel-plan-day__meta"{% if not accountView %} style="color: #e1bd55;"{% endif %}>{{ dayMeta|join(' · ') }}</p>
        {% endif %}
        {% if section.title|default %}<h2{% if not accountView %} style="color: #ffffff;"{% endif %}>{{ section.title }}</h2>{% endif %}
        {% if section.intro|default %}
            {% set introHtml = accountView ? section.intro : section.intro|replace({
                '<p>': '<p style="color: #f7f4ee;">',
                '<li>': '<li style="color: #f7f4ee;">'
            }) %}
            <div class="travel-plan-section__content travel-plan-day__intro"{% if not accountView %} style="color: #f7f4ee;"{% endif %}>{{ introHtml|raw }}</div>
        {% endif %}
    </div>

    {% if renderedBlocks is not empty %}
        <div class="travel-plan-day__blocks{% if accountView %} travel-plan-day__blocks--account{% endif %}">
            {% for renderedBlock in renderedBlocks %}
                {% if accountView %}
                    <div class="travel-plan-day__block-item">
                        {{ renderedBlock.html|raw }}
                        {% if feedbackEnabled|default(false) %}
                            {{ include('account/_travel_plan_feedback_form.html.twig', {
                                travelPlan: travelPlan,
                                blockPath: renderedBlock.blockPath,
                                feedback: renderedBlock.feedback,
                                feedbackLabel: 'Feedback op dit dagonderdeel',
                                feedbackContext: 'block'
                            }) }}
                        {% endif %}
                    </div>
                {% else %}
                    {{ renderedBlock.html|raw }}
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
{% if accountView %}
</section>
{% else %}
</div>
{% endif %}
