<style>
    :root {
    {% for name, v in styleVariants %}
        --tpv-{{ name }}-bg: {{ v.background }};
        --tpv-{{ name }}-edge: {{ v.edge }};
        --tpv-{{ name }}-accent: {{ v.accent ?? v.edge }};
        --tpv-{{ name }}-title: {{ v.title }};
        --tpv-{{ name }}-body: {{ v.body }};
        --tpv-{{ name }}-meta: {{ v.meta }};
        --tpv-{{ name }}-link: {{ v.link }};
    {% endfor %}
    }

    {% for name, v in styleVariants %}
    .travel-plan-variant--{{ name }} {
        --tp-variant-bg: {{ v.background }};
        --tp-variant-edge: {{ v.edge }};
        --tp-variant-accent: {{ v.accent ?? v.edge }};
        --tp-variant-title: {{ v.title }};
        --tp-variant-body: {{ v.body }};
        --tp-variant-meta: {{ v.meta }};
        --tp-variant-link: {{ v.link }};
        --tp-card-zone: var(--tpv-default-bg);
    }
    {% endfor %}
</style>
