<section class="travel-plan-section travel-plan-section--destination {{ section.variantClass|default('travel-plan-variant--default') }}{{ section.pageBreakClass ? ' ' ~ section.pageBreakClass : '' }}">{% if section.iconSvg %}<span class="travel-plan-icon-slot" aria-hidden="true">{{ section.iconSvg|raw }}</span>{% endif %}
    {% if section.title|default %}<h2>{{ section.title }}</h2>{% endif %}
    {% set location = [section.city|default, section.region|default, section.country|default]|filter(value => value)|join(', ') %}
    {% if location %}<p class="travel-plan-section__location">{{ location }}</p>{% endif %}
    {% if section.text|default %}<div class="travel-plan-section__content">{{ section.text|raw }}</div>{% endif %}
</section>
